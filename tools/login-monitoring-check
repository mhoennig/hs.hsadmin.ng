#!/bin/bash

# Monitoring-check for the Keycloak-OIDC integration of a deployed hsadmin-NG backend.
#
# Performs an automated Keycloak login as a dedicated, unprivileged monitoring user
# and verifies that the backend accepts the resulting JWT via GET /api/rbac/context,
# checking that the user stays unprivileged (no global-admin, roles, groups, or grants).
# It additionally verifies, via the public GET /api/rbac/subjects/last-sync, that the
# Keycloak subject-sync reported a run within the configured max age (default 5min).
# The monitoring user only exists as a Keycloak user plus a matching rbac USER subject
# (same name and UUID); it has neither an account nor any role grants, so its
# credentials can be stored on an external monitoring host without a security risk.
#
# Intended for unattended runs (e.g. via cron on a monitoring host): the last stdout
# line is either "OK: ..." or "FAILED: ...", details go to stderr, and the exit code
# is 0 only if the whole check succeeded.
#
# This script is deliberately self-contained (it only needs bash, curl, openssl,
# and optionally jq), so that it can be copied to a monitoring host without the
# rest of this repository. The Keycloak login-form flow is therefore duplicated
# from tools/jwt-login; keep the two scripts in sync.
#
# Configuration via environment variables:
#   HSADMINNG_API_BASE_URL            backend to check, default: https://backend.ng.hostsharing.net
#   HSADMINNG_LOGIN_MONITOR_USERNAME  Keycloak username, default: hsh-login_monitor
#   HSADMINNG_LOGIN_MONITOR_PASSWORD  the monitoring user's Keycloak password, required
#   HSADMINNG_KEYCLOAK_ISSUER         default: https://login.ng.hostsharing.net/realms/hs
#   HSADMINNG_KEYCLOAK_CLIENT_ID      default: hs-admin-web
#   HSADMINNG_KEYCLOAK_REDIRECT_URI   default: https://testui.ng.hostsharing.net/
#   HSADMINNG_LOGIN_MONITOR_SLOW_WARNING_SECONDS
#                                     a successful but slower check raises a latency
#                                     warning above this many seconds, default: 2
#   HSADMINNG_LOGIN_MONITOR_SYNC_KEY_NAME
#                                     API-key subject-name whose sync-runs are checked via
#                                     GET /api/rbac/subjects/last-sync, default: hsadminng.keycloak.sync
#   HSADMINNG_LOGIN_MONITOR_SYNC_MAX_AGE_SECONDS
#                                     fail if the last keycloak-sync run is older than this
#                                     many seconds; 0 disables the sync check, default: 300
#
# Options:
#   -v, --verbose           prints the used username and password to stderr;
#                           for local debugging only, never in unattended runs
#
# Optional Matrix alerting:
#   --matrix-webhook <url>  additionally posts any non-OK result to this webhook,
#                           e.g. a matrix-hookshot generic webhook URL
#   --matrix-webhook        same, with the URL taken from HSADMINNG_MATRIX_WEBHOOK_URL;
#                           prefer this on shared hosts to keep the secret webhook URL
#                           out of the process list
#
#   Messages are colour-coded and icon-tagged by severity: ✅ green RESOLVED,
#   ⚠️ amber SLOW (latency warning), 🚨 red FAILED (login, backend, or sync error), and
#   🆘 dark-red CRITICAL with an @room ping if the monitoring user unexpectedly
#   gained privileges (a security incident).
#
#   While a problem persists, repeated alerts are throttled with a backoff:
#   the first result is posted immediately, repetitions only after the intervals
#   (in hours) listed in HSADMINNG_LOGIN_MONITOR_ALARM_REPEAT (default 1,2,4,8,16,24),
#   with the last interval repeating indefinitely. Once the problem clears, a
#   RESOLVED message is posted. Each alarm — login/backend failure, gained privileges,
#   latency warning and sync-freshness — backs off in its own state file, so that a running
#   backoff can never delay another alarm, least of all the critical one. The state files sit
#   next to HSADMINNG_LOGIN_MONITOR_STATE_FILE (`*.critical.state`, `*.slow.state`,
#   `*.sync.state`), default: ~/.local/state/login-monitoring-check.state
#   ($XDG_STATE_HOME is honored).

set -o pipefail

function failed() {
    echo "FAILED: $*"
    exit 1
}

KEYCLOAK_ISSUER="${HSADMINNG_KEYCLOAK_ISSUER:-https://login.ng.hostsharing.net/realms/hs}"
CLIENT_ID="${HSADMINNG_KEYCLOAK_CLIENT_ID:-hs-admin-web}"
REDIRECT_URI="${HSADMINNG_KEYCLOAK_REDIRECT_URI:-https://testui.ng.hostsharing.net/}"

# Option names differ between curl versions still in use (e.g. RHEL 8: 7.61),
# thus probe the locally installed curl (--version prevents any actual transfer):
CURL=(curl --show-error)
if curl --no-progress-meter --version >/dev/null 2>&1; then
    CURL+=(--no-progress-meter) # since curl 7.67
else
    CURL+=(--silent) # older equivalent, errors still shown due to --show-error
fi
if curl --fail-with-body --version >/dev/null 2>&1; then
    CURL+=(--fail-with-body) # since curl 7.76
else
    CURL+=(--fail) # older variant, unfortunately suppressing the response body on HTTP errors
fi

# encodes $1 as a JSON string literal (including the surrounding quotes)
function jsonString() {
    if command -v jq >/dev/null 2>&1; then
        jq -n --arg s "$1" '$s'
    else
        local s=${1//\\/\\\\}
        s=${s//\"/\\\"}
        s=${s//$'\n'/\\n}
        s=${s//$'\t'/\\t}
        printf '"%s"' "$s"
    fi
}

# escapes $1 for use inside a Matrix HTML formatted_body
function htmlEscape() {
    local s=${1//&/&amp;}
    s=${s//</&lt;}
    s=${s//>/&gt;}
    printf '%s' "$s"
}

# posts $1 to the Matrix webhook, styled by the severity $2 (ok|warn|alert|critical,
# default info); a no-op unless --matrix-webhook was given. Both a plain-text and an
# HTML body are sent, so colour-capable clients (e.g. Element) show the severity colour
# while others fall back. Critical prepends @room to notify the whole room.
function sendMatrixMessage() {
    [ -n "$MATRIX_WEBHOOK_URL" ] || return 0
    local body=$1 icon color mention=''
    case "${2:-info}" in
        ok)       icon='✅'; color='#2e7d32' ;;
        warn)     icon='⚠️'; color='#f9a825' ;;
        alert)    icon='🚨'; color='#c62828' ;;
        critical) icon='🆘'; color='#7f0000'; mention='@room ' ;;
        *)        icon='ℹ️'; color='#1f6feb' ;;
    esac
    local footer="backend: ${HSADMINNG_API_BASE_URL:-not configured yet}, checked from: ${USER:-$(id -un)}@${HOSTNAME:-$(hostname)}"
    # the two trailing spaces are Markdown hard line breaks, so that Matrix renders multiple lines
    local text="${mention}"$'  \n'"$icon $body"$'  \n'"$footer"
    local html="${mention}<br><font color=\"$color\">$icon $(htmlEscape "$body")</font><br>$(htmlEscape "$footer")"
    html=${html//$'\n'/<br>}
    # The secret webhook URL is passed as a curl config via stdin (--config -)
    # to keep it out of curl's process-list entry, like the password in keycloakLogin.
    printf 'url = "%s"\n' "$MATRIX_WEBHOOK_URL" |
        "${CURL[@]}" --config - -X POST -H 'Content-Type: application/json' \
            -d "{\"username\": \"login-monitoring-check\", \"text\": $(jsonString "$text"), \"html\": $(jsonString "$html")}" \
            >/dev/null || {
        echo "ERROR: could not send the message to the Matrix webhook" >&2
        return 1
    }
}

# formats a duration given in seconds as e.g. 26h05m
function formatDuration() {
    printf '%dh%02dm' $(( $1 / 3600 )) $(( $1 % 3600 / 60 ))
}

# Posts a $1-severity alert for the problem tracked in state file $2, with message $3,
# throttled via that state file: the first occurrence alerts immediately, repetitions
# only after the ALARM_REPEAT interval which applies to the current alert count. If
# sending fails, the state is not updated, so the next run retries.
function sendThrottledAlert() {
    [ -n "$MATRIX_WEBHOOK_URL" ] || return 0
    local severity=$1 stateFile=$2 message=$3
    local now FIRST_FAILURE_TS='' LAST_ALERT_TS=0 ALERT_COUNT=0
    now=$(date +%s)
    [ ! -f "$stateFile" ] || source "$stateFile"
    if [ "$ALERT_COUNT" -gt 0 ]; then
        local gaps=()
        IFS=, read -ra gaps <<<"$ALARM_REPEAT"
        local idx=$(( ALERT_COUNT <= ${#gaps[@]} ? ALERT_COUNT - 1 : ${#gaps[@]} - 1 ))
        local dueTs=$(( LAST_ALERT_TS + gaps[idx] * 3600 ))
        if [ "$now" -lt "$dueTs" ]; then
            echo "Matrix alert #$(( ALERT_COUNT + 1 )) suppressed by HSADMINNG_LOGIN_MONITOR_ALARM_REPEAT until $(date -d "@$dueTs" '+%F %T')" >&2
            return 0
        fi
        sendMatrixMessage "$message"$'  \n'"(alert #$(( ALERT_COUNT + 1 )), ongoing since $(date -d "@$FIRST_FAILURE_TS" '+%F %T') = $(formatDuration $(( now - FIRST_FAILURE_TS ))))" "$severity" ||
            return 0
    else
        FIRST_FAILURE_TS=$now
        sendMatrixMessage "$message" "$severity" || return 0
    fi
    mkdir -p "$(dirname "$stateFile")"
    printf 'FIRST_FAILURE_TS=%s\nLAST_ALERT_TS=%s\nALERT_COUNT=%s\n' \
            "$FIRST_FAILURE_TS" "$now" "$(( ALERT_COUNT + 1 ))" >"$stateFile.tmp" &&
        mv "$stateFile.tmp" "$stateFile"
}

# posts the all-clear $2 if an alarm is active in state file $1, and clears it;
# if sending fails, the state is kept, so the next healthy run retries
function sendMatrixResolved() {
    [ -n "$MATRIX_WEBHOOK_URL" ] && [ -f "$1" ] || return 0
    local stateFile=$1 resolved=$2
    local now FIRST_FAILURE_TS='' LAST_ALERT_TS=0 ALERT_COUNT=0
    now=$(date +%s)
    source "$stateFile"
    sendMatrixMessage "$resolved (after $ALERT_COUNT alert(s) since $(date -d "@$FIRST_FAILURE_TS" '+%F %T') = $(formatDuration $(( now - FIRST_FAILURE_TS ))))" ok &&
        rm -f "$stateFile"
}

function failed() {
    echo "FAILED: $*"
    sendThrottledAlert alert "$STATE_FILE" "FAILED: $*"
    exit 1
}

# like failed(), but a critical security alert (🆘, @room); its own state file, because a
# security incident must alert immediately even while an outage alarm is already backing off
function critical() {
    echo "CRITICAL: $*"
    # reaching a critical check proves login works: close a pending failure alarm right here,
    # also so that no stale state from the formerly shared file can fake a later login-RESOLVED
    sendMatrixResolved "$STATE_FILE" "RESOLVED: $HSADMINNG_JWT_USERNAME can log in again"
    sendThrottledAlert critical "$CRITICAL_STATE_FILE" "CRITICAL: $*"
    exit 1
}

# like failed(), but for the independent keycloak-sync freshness check; its own state
# file keeps its backoff separate from the login/backend failure alarm
function syncFailed() {
    echo "FAILED: $*"
    sendThrottledAlert alert "$SYNC_STATE_FILE" "SYNC-FAILED: $*"
    exit 1
}

# backoff configuration for repeated Matrix alerts, see the header comment
ALARM_REPEAT=${HSADMINNG_LOGIN_MONITOR_ALARM_REPEAT:-1,2,4,8,16,24}
if ! [[ "$ALARM_REPEAT" =~ ^[0-9]+(,[0-9]+)*$ ]]; then
    echo "WARNING: ignoring invalid HSADMINNG_LOGIN_MONITOR_ALARM_REPEAT '$ALARM_REPEAT', using 1,2,4,8,16,24" >&2
    ALARM_REPEAT=1,2,4,8,16,24
fi
STATE_FILE=${HSADMINNG_LOGIN_MONITOR_STATE_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/login-monitoring-check.state}
# every alarm gets its own state file, so that no alarm's backoff can ever delay another one
WARN_STATE_FILE="${STATE_FILE%.state}.slow.state"
SYNC_STATE_FILE="${STATE_FILE%.state}.sync.state"
CRITICAL_STATE_FILE="${STATE_FILE%.state}.critical.state"
# a successful but slower-than-this (seconds) check raises a latency warning
SLOW_WARNING_SECONDS=${HSADMINNG_LOGIN_MONITOR_SLOW_WARNING_SECONDS:-2}
if ! [[ "$SLOW_WARNING_SECONDS" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    echo "WARNING: ignoring invalid HSADMINNG_LOGIN_MONITOR_SLOW_WARNING_SECONDS '$SLOW_WARNING_SECONDS', using 2" >&2
    SLOW_WARNING_SECONDS=2
fi
# the API-key subject-name whose sync-runs are monitored, and the max tolerated age (0 disables)
SYNC_KEY_NAME=${HSADMINNG_LOGIN_MONITOR_SYNC_KEY_NAME:-hsadminng.keycloak.sync}
SYNC_MAX_AGE_SECONDS=${HSADMINNG_LOGIN_MONITOR_SYNC_MAX_AGE_SECONDS:-300}
if ! [[ "$SYNC_MAX_AGE_SECONDS" =~ ^[0-9]+$ ]]; then
    echo "WARNING: ignoring invalid HSADMINNG_LOGIN_MONITOR_SYNC_MAX_AGE_SECONDS '$SYNC_MAX_AGE_SECONDS', using 300" >&2
    SYNC_MAX_AGE_SECONDS=300
fi

# lets a test source just the functions and the configuration above, without performing a check;
# `return` only works when sourced, a direct execution needs `exit` lest the check runs anyway
[ -z "${HSADMINNG_LOGIN_MONITOR_DEFINE_ONLY:-}" ] || return 0 2>/dev/null || exit 0

MATRIX_WEBHOOK_URL=
VERBOSE=
while [ $# -gt 0 ]; do
    case $1 in
        -v|--verbose)
            VERBOSE=1
            ;;
        --matrix-webhook=*)
            MATRIX_WEBHOOK_URL=${1#*=}
            ;;
        --matrix-webhook)
            if [ $# -gt 1 ] && [[ $2 != --* ]]; then
                MATRIX_WEBHOOK_URL=$2
                shift
            else
                MATRIX_WEBHOOK_URL=$HSADMINNG_MATRIX_WEBHOOK_URL
            fi
            [ -n "$MATRIX_WEBHOOK_URL" ] ||
                failed "--matrix-webhook needs a URL argument or HSADMINNG_MATRIX_WEBHOOK_URL set"
            ;;
        *)
            failed "unknown argument: $1 (usage: $0 [-v|--verbose] [--matrix-webhook [<url>]])"
            ;;
    esac
    shift
done

HSADMINNG_API_BASE_URL=${HSADMINNG_API_BASE_URL:-https://backend.ng.hostsharing.net}
[ -n "$HSADMINNG_LOGIN_MONITOR_PASSWORD" ] || failed "HSADMINNG_LOGIN_MONITOR_PASSWORD is not set"
# the keycloakLogin function below is kept in sync with tools/jwt-login,
# which expects the credentials in the generic variables
HSADMINNG_JWT_USERNAME=${HSADMINNG_LOGIN_MONITOR_USERNAME:-hsh-login_monitor}
HSADMINNG_JWT_PASSWORD=$HSADMINNG_LOGIN_MONITOR_PASSWORD

KEYCLOAK_ISSUER="${HSADMINNG_KEYCLOAK_ISSUER:-https://login.ng.hostsharing.net/realms/hs}"
CLIENT_ID="${HSADMINNG_KEYCLOAK_CLIENT_ID:-hs-admin-web}"
REDIRECT_URI="${HSADMINNG_KEYCLOAK_REDIRECT_URI:-https://testui.ng.hostsharing.net/}"

# Performs the OAuth2 authorization-code flow with PKCE, scripted through the
# Keycloak login form (incl. username-first and identity-broker redirects) and
# prints the access token to stdout; duplicated from tools/jwt-login, see above.
# The subshell body `( ... )` keeps `set`, `trap`, and all variables local.
function keycloakLogin() (
  set -o pipefail

  COOKIE_JAR=$(mktemp) || exit 1
  RESPONSE_BODY=$(mktemp) || exit 1
  trap 'rm -f "$COOKIE_JAR" "$RESPONSE_BODY"' EXIT

  function formAction() {
    grep -o 'action="[^"]*"' <<<"$1" | head -1 | sed -e 's/^action="//' -e 's/"$//' -e 's/&amp;/\&/g'
  }

  function pageError() {
    local errorText
    errorText=$(tr -d '\n' <"$RESPONSE_BODY" |
        grep -o -E '(kc-feedback-text"|id="input-error[^"]*"[^>]*)>[[:space:]]*[^<[:space:]][^<]*' | head -1 |
        sed -e 's/^[^>]*>[[:space:]]*//' -e 's/[[:space:]]*$//')
    echo "${errorText:-check your credentials}"
  }

  CODE_VERIFIER=$(openssl rand -base64 48 | tr '+/' '-_' | tr -d '=')
  CODE_CHALLENGE=$(printf '%s' "$CODE_VERIFIER" | openssl dgst -sha256 -binary | base64 | tr '+/' '-_' | tr -d '=')

  LOGIN_FORM=$("${CURL[@]}" -c "$COOKIE_JAR" -G "$KEYCLOAK_ISSUER/protocol/openid-connect/auth" \
      -d "client_id=$CLIENT_ID" \
      --data-urlencode "redirect_uri=$REDIRECT_URI" \
      -d response_type=code \
      -d scope=openid \
      -d "code_challenge=$CODE_CHALLENGE" \
      -d code_challenge_method=S256) || exit 1

  FORM_ACTION=$(formAction "$LOGIN_FORM")
  if [ -z "$FORM_ACTION" ]; then
    echo "ERROR: could not find the Keycloak login form at $KEYCLOAK_ISSUER" >&2
    exit 1
  fi

  if grep -q 'name="password"' <<<"$LOGIN_FORM"; then
    # single-page flow: username and password are posted to the same form
    PASSWORD_FORM=$LOGIN_FORM
  else
    # username-first flow: POST the username; -L follows possible identity-broker
    # redirects, the response then contains the (possibly brokered) password form
    PASSWORD_FORM=$("${CURL[@]}" -L -b "$COOKIE_JAR" -c "$COOKIE_JAR" \
        --data-urlencode "username=$HSADMINNG_JWT_USERNAME" \
        "$FORM_ACTION") || exit 1
    printf '%s' "$PASSWORD_FORM" >"$RESPONSE_BODY"
    FORM_ACTION=$(formAction "$PASSWORD_FORM")
    if [ -z "$FORM_ACTION" ] || ! grep -q 'name="password"' <<<"$PASSWORD_FORM"; then
      echo "ERROR: login failed after submitting the username: $(pageError)" >&2
      exit 1
    fi
  fi

  if grep -q 'name="username"' <<<"$PASSWORD_FORM"; then
    # a brokered password form pre-fills the username (e.g. with the email address); re-post that value
    PREFILLED_USERNAME=$(grep -o '<input[^>]*name="username"[^>]*' <<<"$PASSWORD_FORM" |
        grep -o 'value="[^"]*"' | head -1 | sed -e 's/^value="//' -e 's/"$//')
    USERNAME_ARGUMENTS=(--data-urlencode "username=${PREFILLED_USERNAME:-$HSADMINNG_JWT_USERNAME}")
  else
    USERNAME_ARGUMENTS=()
  fi

  # The password is passed via stdin (--data-urlencode name@-) to keep it out of the process list.
  # On success, -L follows the redirects back through the broker to $REDIRECT_URI?...&code=...,
  # and %{url_effective} keeps that query-string with the authorization code.
  FINAL_URL=$(printf '%s' "$HSADMINNG_JWT_PASSWORD" | \
      "${CURL[@]}" -L -b "$COOKIE_JAR" -c "$COOKIE_JAR" -o "$RESPONSE_BODY" -w '%{url_effective}' \
          "${USERNAME_ARGUMENTS[@]}" \
          --data-urlencode "password@-" \
          -d "credentialId=" \
          "$FORM_ACTION") || exit 1

  AUTH_CODE=$(grep -o '[?&]code=[^&]*' <<<"$FINAL_URL" | tail -1 | cut -d= -f2)
  if [ -z "$AUTH_CODE" ]; then
    echo "ERROR: login failed: $(pageError)" >&2
    echo "       (last page was $FINAL_URL," >&2
    echo "        maybe the account requires OTP/2FA or another action, which this script does not support)" >&2
    exit 1
  fi

  ACCESS_TOKEN=$("${CURL[@]}" -X POST "$KEYCLOAK_ISSUER/protocol/openid-connect/token" \
      -d grant_type=authorization_code \
      -d "client_id=$CLIENT_ID" \
      --data-urlencode "redirect_uri=$REDIRECT_URI" \
      -d "code=$AUTH_CODE" \
      -d "code_verifier=$CODE_VERIFIER" |
    grep -o '"access_token":"[^"]*' | cut -d'"' -f4)
  if [ -z "$ACCESS_TOKEN" ]; then
    echo "ERROR: could not exchange the authorization code for an access token" >&2
    exit 1
  fi

  echo "$ACCESS_TOKEN"
)

# wall-clock timing helpers: startTimer just before a request, tookFor after its
# response body was logged, so a SLOW check can be attributed to a single request.
# tookFor's label omits query parameters and body, and it emits a trailing blank
# line to visually separate the probed steps.
function startTimer() { REQUEST_START=$(date +%s.%N); }
function tookFor() {
    echo "  took $(awk "BEGIN { printf \"%.3f\", $(date +%s.%N) - $REQUEST_START }")s for $1" >&2
    echo >&2
}

checkStart=$(date +%s.%N)
echo "probing: LOGIN $HSADMINNG_JWT_USERNAME at $KEYCLOAK_ISSUER" >&2
[ -n "$VERBOSE" ] && echo "  username='$HSADMINNG_JWT_USERNAME' password='$HSADMINNG_JWT_PASSWORD'" >&2
startTimer
ACCESS_TOKEN=$(keycloakLogin) && [ -n "$ACCESS_TOKEN" ] ||
    failed "Keycloak login as $HSADMINNG_JWT_USERNAME"
tookFor LOGIN

contextRequest="GET $HSADMINNG_API_BASE_URL/api/rbac/context"
echo "probing: $contextRequest" >&2
startTimer
response=$("${CURL[@]}" -H "Authorization: Bearer $ACCESS_TOKEN" \
        "$HSADMINNG_API_BASE_URL/api/rbac/context") || {
    # the error response body (captured via --fail-with-body) often explains the cause,
    # e.g. "cannot find Subject by uuid ..." if the rbac subject does not match the JWT
    [ -n "$response" ] && printf '%s\n' "$response" >&2
    failed "GET /api/rbac/context on $HSADMINNG_API_BASE_URL with the obtained JWT"
}
printf '%s\n' "$response" >&2
tookFor "$contextRequest"

# the context above only reflects *active* authority; a latent, assumable grant would
# stay invisible there, so additionally fetch the raw grants of the current subject
grantsRequest="GET $HSADMINNG_API_BASE_URL/api/rbac/grants"
echo "probing: $grantsRequest" >&2
startTimer
grantsResponse=$("${CURL[@]}" -H "Authorization: Bearer $ACCESS_TOKEN" \
        "$HSADMINNG_API_BASE_URL/api/rbac/grants") || {
    [ -n "$grantsResponse" ] && printf '%s\n' "$grantsResponse" >&2
    failed "GET /api/rbac/grants on $HSADMINNG_API_BASE_URL with the obtained JWT"
}
printf '%s\n' "$grantsResponse" >&2
tookFor "$grantsRequest"

# verify that the backend resolved the JWT to the expected subject
if command -v jq >/dev/null 2>&1; then
    subjectName=$(jq -r '.subject.name // empty' <<<"$response")
else
    # fallback without jq: the subject is the first object with a "name" property
    subjectName=$(grep -o '"name"[[:space:]]*:[[:space:]]*"[^"]*"' <<<"$response" |
        head -1 | sed -e 's/.*"\([^"]*\)"$/\1/')
fi
[ "$subjectName" == "$HSADMINNG_JWT_USERNAME" ] ||
    failed "expected subject '$HSADMINNG_JWT_USERNAME' in /api/rbac/context, but got '$subjectName'"

# true if the given JSON field is present in the response as an empty array
function isEmptyArray() {
    local field=$1
    if command -v jq >/dev/null 2>&1; then
        jq -e --arg f "$field" '.[$f] == []' <<<"$response" >/dev/null
    else
        # fallback without jq: an empty array is "field":[] (optional whitespace);
        # a non-empty or missing array does not match, so the check fails safely
        grep -qE "\"$field\"[[:space:]]*:[[:space:]]*\[[[:space:]]*\]" <<<"$response"
    fi
}

# the monitoring user must stay unprivileged; a gained role, group, or admin right is a
# security incident, not a mere outage, so it escalates to a critical alert
if grep -qE '"globalAdmin"[[:space:]]*:[[:space:]]*true' <<<"$response"; then
    critical "monitoring user $HSADMINNG_JWT_USERNAME unexpectedly has global-admin rights"
fi
isEmptyArray assumedRoles ||
    critical "monitoring user $HSADMINNG_JWT_USERNAME unexpectedly has assumed roles in /api/rbac/context"
isEmptyArray effectiveGroups ||
    critical "monitoring user $HSADMINNG_JWT_USERNAME unexpectedly has effective groups in /api/rbac/context"

# the monitoring user must have zero role grants; any grant — even a latent, assumable one
# that the context above cannot reveal — is a security incident
if command -v jq >/dev/null 2>&1; then
    grantCount=$(jq 'length' <<<"$grantsResponse")
    grantedRoles=$(jq -r '[.[].grantedRoleIdName // "?"] | join(", ")' <<<"$grantsResponse")
else
    # fallback without jq: an empty array is just [] (optional whitespace); anything else
    # (including an unparseable body) fails the check, so it errs towards alerting
    grantCount=$([[ "$grantsResponse" =~ ^[[:space:]]*\[[[:space:]]*\][[:space:]]*$ ]] && echo 0 || echo unknown)
    grantedRoles=$grantsResponse
fi
[ "$grantCount" = 0 ] ||
    critical "monitoring user $HSADMINNG_JWT_USERNAME unexpectedly has $grantCount role grant(s): $grantedRoles"

# the login/backend side is healthy and the user is unprivileged again -> clear both alarms
sendMatrixResolved "$STATE_FILE" "RESOLVED: $HSADMINNG_JWT_USERNAME can log in again"
sendMatrixResolved "$CRITICAL_STATE_FILE" "RESOLVED: $HSADMINNG_JWT_USERNAME is unprivileged again"

# independently verify that the Keycloak subject-sync is alive: the syncer posts an
# end-of-run report which the public GET /api/rbac/subjects/last-sync exposes as a bare
# timestamp (no credentials needed, hence safe to poll from this unprivileged host)
if [ "$SYNC_MAX_AGE_SECONDS" -eq 0 ]; then
    syncSummary=" (sync-check disabled)"
    echo "SYNC CHECK DISABLED (HSADMINNG_LOGIN_MONITOR_SYNC_MAX_AGE_SECONDS=0)" >&2
else
    # query a window wider than the threshold, so the actual age can be reported even for a
    # moderately stale sync; freshness is then decided locally against the threshold
    syncQueryWindowSeconds=$(( SYNC_MAX_AGE_SECONDS * 4 ))
    [ "$syncQueryWindowSeconds" -lt 3600 ] && syncQueryWindowSeconds=3600
    echo "probing: GET $HSADMINNG_API_BASE_URL/api/rbac/subjects/last-sync?name=$SYNC_KEY_NAME&interval=PT${syncQueryWindowSeconds}S" >&2
    startTimer
    lastSyncResponse=$("${CURL[@]}" -G "$HSADMINNG_API_BASE_URL/api/rbac/subjects/last-sync" \
            --data-urlencode "name=$SYNC_KEY_NAME" \
            --data-urlencode "interval=PT${syncQueryWindowSeconds}S") || {
        [ -n "$lastSyncResponse" ] && printf '%s\n' "$lastSyncResponse" >&2
        syncFailed "GET /api/rbac/subjects/last-sync on $HSADMINNG_API_BASE_URL"
    }
    printf '%s\n' "$lastSyncResponse" >&2
    tookFor "GET $HSADMINNG_API_BASE_URL/api/rbac/subjects/last-sync"
    if command -v jq >/dev/null 2>&1; then
        lastSyncAt=$(jq -r '.timestamp // empty' <<<"$lastSyncResponse")
    else
        # fallback without jq: "timestamp":"..."; a null or missing value yields empty
        lastSyncAt=$(grep -o '"timestamp"[[:space:]]*:[[:space:]]*"[^"]*"' <<<"$lastSyncResponse" |
            head -1 | sed -e 's/.*"\([^"]*\)"$/\1/')
    fi
    [ -n "$lastSyncAt" ] ||
        syncFailed "no keycloak-sync ($SYNC_KEY_NAME) report within the last ${SYNC_MAX_AGE_SECONDS}s; the sync appears to be down"
    lastSyncEpoch=$(date -d "$lastSyncAt" +%s 2>/dev/null) ||
        syncFailed "could not parse lastSyncAt '$lastSyncAt' from /api/rbac/subjects/last-sync"
    syncAgeSeconds=$(( $(date +%s) - lastSyncEpoch ))
    [ "$syncAgeSeconds" -le "$SYNC_MAX_AGE_SECONDS" ] ||
        syncFailed "last keycloak-sync ($SYNC_KEY_NAME) ran ${syncAgeSeconds}s ago, exceeding the ${SYNC_MAX_AGE_SECONDS}s threshold"
    sendMatrixResolved "$SYNC_STATE_FILE" "RESOLVED: keycloak-sync ($SYNC_KEY_NAME) is running again (last report ${syncAgeSeconds}s ago)"
    echo "SYNC OK: last keycloak-sync ($SYNC_KEY_NAME) report ${syncAgeSeconds}s ago (<= ${SYNC_MAX_AGE_SECONDS}s)" >&2
    syncSummary=" and keycloak-sync ran ${syncAgeSeconds}s ago"
fi

echo >&2
checkDuration=$(awk "BEGIN { printf \"%.3f\", $(date +%s.%N) - $checkStart }")
if awk "BEGIN { exit !($checkDuration > $SLOW_WARNING_SECONDS) }"; then
    sendThrottledAlert warn "$WARN_STATE_FILE" "SLOW: the complete check took ${checkDuration}s (warning above ${SLOW_WARNING_SECONDS}s)"
    echo "OK (SLOW: ${checkDuration}s > ${SLOW_WARNING_SECONDS}s): $HSADMINNG_JWT_USERNAME logged in via Keycloak and was successfully accepted by $HSADMINNG_API_BASE_URL${syncSummary}"
else
    sendMatrixResolved "$WARN_STATE_FILE" "RESOLVED: check latency for $HSADMINNG_JWT_USERNAME is back to normal (${checkDuration}s)"
    echo "OK: $HSADMINNG_JWT_USERNAME logged in via Keycloak and was successfully accepted by $HSADMINNG_API_BASE_URL (${checkDuration}s)${syncSummary}"
fi
