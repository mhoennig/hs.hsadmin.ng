#!/bin/bash

# Smoke-test for the local dev tooling: boots the application via `bootRun` with
# --spring.profiles.active=dev,fake-jwt,complete,test-data against a separate throw-away
# Docker-PostgreSQL, then exercises the LOGIN, APIKEY and HTTP functions from `.aliases`
# with some simple (ping, version) and some more complex (POST with RBAC grants) endpoints,
# including the provisioning API-key bootstrap (HSADMINNG_PROVISIONING_API_KEY_SHA256) and creating
# a further API-key with it. It also exercises the tooling scripts
# `tools/create-accounts-from-csv`, `tools/create-api-key-for-keycloak-sync` and, against a
# stubbed ssh, `tools/remote backend sql`.
#
# The throw-away database container (hsadmin-ng-smoke-test-postgres, host port 15432) is
# reset at the start and removed at the end; the normal `hsadmin-ng-postgres` container
# and its data remain untouched. The application listens on a separate port (8090) as
# well, so a normally running local application instance is not affected either.
# Both ports are checked to be free beforehand, so the test cannot accidentally hit
# some other service (e.g. a native PostgreSQL cluster).
#
# Exit code 0 if everything works, otherwise 1 with an error message naming the failed step.
#
# Overridable via environment:
#   HSADMINNG_SMOKE_TEST_PG_PORT          host port of the throw-away database (default 15432)
#   HSADMINNG_SMOKE_TEST_APP_PORT         application port, management port is +1 (default 8090)
#   HSADMINNG_SMOKE_TEST_STARTUP_TIMEOUT  seconds to wait for the application (default 300)

cd "$(dirname "$0")/.." || exit 1

PG_CONTAINER=hsadmin-ng-smoke-test-postgres
PG_IMAGE=postgres:17.7-trixie # keep in sync with the README and the normal local database
PG_PORT=${HSADMINNG_SMOKE_TEST_PG_PORT:-15432}
APP_PORT=${HSADMINNG_SMOKE_TEST_APP_PORT:-8090}
STARTUP_TIMEOUT=${HSADMINNG_SMOKE_TEST_STARTUP_TIMEOUT:-300}
LOG_FILE=build/smoke-test/bootRun.log

passed() {
    echo "PASSED"
}
failed() {
    echo "FAILED" >&2
    echo >&2
    echo "SMOKE-TEST FAILED: $*" >&2
    if [ -f "$LOG_FILE" ]; then
        echo "--- last lines of $LOG_FILE: ---" >&2
        tail -n 25 "$LOG_FILE" >&2
    fi
    exit 1
}

GRADLE_PID=
cleanup() {
    if [ -n "$GRADLE_PID" ] && kill -0 "$GRADLE_PID" 2>/dev/null; then
        echo "stopping the application (pid $GRADLE_PID)"
        # negative pid: terminate the whole process group (gradle + the forked application JVM)
        kill -TERM -- "-$GRADLE_PID" 2>/dev/null || kill -TERM "$GRADLE_PID" 2>/dev/null
        for _ in $(seq 1 15); do
            kill -0 "$GRADLE_PID" 2>/dev/null || break
            sleep 1
        done
        kill -KILL -- "-$GRADLE_PID" 2>/dev/null
    fi
    docker rm -f "$PG_CONTAINER" >/dev/null 2>&1
}
trap cleanup EXIT

command -v docker >/dev/null || { echo "SMOKE-TEST FAILED: docker is not available" >&2; exit 1; }
# needed by tools/create-api-key-for-keycloak-sync resp. tools/create-accounts-from-csv
command -v jq >/dev/null || { echo "SMOKE-TEST FAILED: jq is not available" >&2; exit 1; }
command -v python3 >/dev/null || { echo "SMOKE-TEST FAILED: python3 is not available" >&2; exit 1; }
# needed by tools/remote backend sql
command -v psql >/dev/null || { echo "SMOKE-TEST FAILED: psql is not available" >&2; exit 1; }

portInUse() {
    (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
}
portInUse "$PG_PORT" && failed "host port $PG_PORT is already in use, override via HSADMINNG_SMOKE_TEST_PG_PORT"
portInUse "$APP_PORT" && failed "host port $APP_PORT is already in use, override via HSADMINNG_SMOKE_TEST_APP_PORT"
portInUse "$((APP_PORT + 1))" && failed "host port $((APP_PORT + 1)) (management) is already in use, override via HSADMINNG_SMOKE_TEST_APP_PORT"

# get the LOGIN/HTTP functions; this test exports its complete environment explicitly below,
# so suppress the personal `.environment` here and in the child-process tools it exercises
export HSADMINNG_SKIP_ENVIRONMENT_FILE=true
source .aliases || failed "cannot source .aliases"
source .unset-environment

# same environment as an .environment-fake-jwt-local setup, but pointing to the
# throw-away database and to a separate application port
export HSADMINNG_POSTGRES_JDBC_URL=jdbc:postgresql://127.0.0.1:$PG_PORT/postgres
export HSADMINNG_POSTGRES_ADMIN_USERNAME=postgres
export HSADMINNG_POSTGRES_ADMIN_PASSWORD=password
export HSADMINNG_POSTGRES_RESTRICTED_USERNAME=restricted
export HSADMINNG_SUPERUSER=hsh-alex_superuser
export HSADMINNG_MIGRATION_DATA_PATH=migration
export HSADMINNG_OFFICE_DATA_SQL_FILE=
export LANG=en_US.UTF-8
export ALLOWED_ORIGINS=http://127.0.0.1:8082
export SERVER_PORT=$APP_PORT
export MANAGEMENT_SERVER_PORT=$((APP_PORT + 1))
unset SPRING_DATASOURCE_URL SPRING_DATASOURCE_USERNAME SPRING_DATASOURCE_PASSWORD
unset SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI

export HSADMINNG_API_BASE_URL=http://127.0.0.1:$APP_PORT
export HSADMINNG_JWT_TOKEN_URL=http://127.0.0.1:$APP_PORT/fake-jwt/token
export HSADMINNG_JWT_CLIENT_ID=hsscript.ng
export HSADMINNG_JWT_CLIENT_SECRET=
export HSADMINNG_JWT_USERNAME=hsh-alex_superuser
export HSADMINNG_JWT_PASSWORD=password # not actually checked by the fake-jwt endpoint
unset HSADMINNG_JWT_BEARER HSADMINNG_API_KEY

# the bootstrap provisions the API_KEY subject 'hsadminng.provisioning.key' with the global ADMIN
# role from just the SHA-256 hash; the clear-text key exists only in this shell,
# like at a real client
provisioningApiKey=$(tools/api-key-generate hsadminng.provisioning.key)
export HSADMINNG_PROVISIONING_API_KEY_SHA256=$(tools/api-key-hash "$provisioningApiKey")

echo "resetting the throw-away database container $PG_CONTAINER (host port $PG_PORT)"
docker rm -f "$PG_CONTAINER" >/dev/null 2>&1
docker run --name "$PG_CONTAINER" -e POSTGRES_PASSWORD=password \
        -p "127.0.0.1:$PG_PORT:5432" -d "$PG_IMAGE" >/dev/null ||
    failed "cannot start the PostgreSQL container $PG_CONTAINER"
for i in $(seq 1 30); do
    # -h localhost forces TCP, so PostgreSQL's socket-only init phase does not count as ready
    docker exec "$PG_CONTAINER" pg_isready -q -h localhost -U postgres 2>/dev/null && break
    [ "$i" == 30 ] && failed "PostgreSQL in $PG_CONTAINER did not become ready"
    sleep 1
done

echo "starting the application on port $APP_PORT (log: $LOG_FILE)"
mkdir -p "$(dirname "$LOG_FILE")"
# setsid (if available) makes gradle a process group leader, so cleanup() can
# terminate gradle and the forked application JVM together
SETSID=$(command -v setsid || true)
$SETSID ./gradlew --no-daemon bootRun \
    --args='--spring.profiles.active=dev,fake-jwt,complete,test-data' >"$LOG_FILE" 2>&1 &
GRADLE_PID=$!

echo "waiting for the application to answer (up to ${STARTUP_TIMEOUT}s) ..."
for i in $(seq 1 "$STARTUP_TIMEOUT"); do
    kill -0 "$GRADLE_PID" 2>/dev/null || failed "bootRun terminated prematurely"
    curl -sf "http://127.0.0.1:$APP_PORT/api/version" >/dev/null 2>&1 && break
    [ "$i" == "$STARTUP_TIMEOUT" ] && failed "the application did not answer within ${STARTUP_TIMEOUT}s"
    sleep 1
done
echo "the application is up"

echo "LOGIN as $HSADMINNG_JWT_USERNAME via the fake-jwt token endpoint"
LOGIN || failed "LOGIN as $HSADMINNG_JWT_USERNAME failed"
[ -n "$HSADMINNG_JWT_BEARER" ] || failed "LOGIN did not export HSADMINNG_JWT_BEARER"
passed

response=$(HTTP GET /api/ping) || failed "GET /api/ping failed"
grep -q 'pinged' <<<"$response" || failed "GET /api/ping did not answer with 'pinged ...' but: $response"
passed

response=$(HTTP GET /api/version) || failed "GET /api/version failed"
grep -q '"version"' <<<"$response" || failed "GET /api/version returned no version property but: $response"
passed

# pong replies with the authenticated username, verifying the JWT actually got applied
response=$(HTTP GET /api/pong) || failed "GET /api/pong failed"
grep -q "$HSADMINNG_JWT_USERNAME" <<<"$response" ||
    failed "GET /api/pong did not reply with the login username but: $response"
passed

# a POST exercising the RBAC machinery (INSERT permission, role grants), see the README
response=$(HTTP POST /api/test/customers -H 'Content-Type: application/json' --data-binary @- <<EOF
{ "prefix": "ttt", "reference": 80001, "adminUserName": "admin@ttt.example.com" }
EOF
) || failed "POST /api/test/customers failed"
grep -q '"uuid"' <<<"$response" || failed "POST /api/test/customers returned no uuid but: $response"
passed

response=$(HTTP GET /api/test/customers) || failed "GET /api/test/customers failed"
grep -q '"ttt"' <<<"$response" ||
    failed "the created test-customer 'ttt' is missing in GET /api/test/customers"
passed

# switch HTTP from the JWT to the bootstrapped provisioning API-key (global-admin)
echo "APIKEY --transient switches the HTTP function from the JWT to the provisioning API-key"
APIKEY --transient <<<"$provisioningApiKey" || failed "APIKEY --transient (provisioning API-key) failed"
[ -n "$HSADMINNG_API_KEY" ] || failed "APIKEY did not export HSADMINNG_API_KEY"
[ -z "$HSADMINNG_JWT_BEARER" ] || failed "APIKEY did not unset HSADMINNG_JWT_BEARER"
passed

# acting as the provisioning API-key, create a further API_KEY subject;
# the clear-text API-key is contained in the creation response exactly once
response=$(HTTP POST /api/rbac/subjects -H 'Content-Type: application/json' --data-binary @- <<EOF
{ "name": "smoke.test.key", "type": "API_KEY" }
EOF
) || failed "POST /api/rbac/subjects (type API_KEY) with the provisioning API-key failed"
apiKey=$(sed -n 's/.*"apiKey" *: *"\(hsak_[^"]*\)".*/\1/p' <<<"$response")
[ -n "$apiKey" ] || failed "POST /api/rbac/subjects returned no clear-text apiKey but: $response"
passed

# switch to the created API-key; the context endpoint reflects its subject, verifying
# the implicit Hostsharing-Api-Key header actually got applied
echo "APIKEY --transient switches the HTTP function to the created API-key"
APIKEY --transient <<<"$apiKey" || failed "APIKEY --transient (created API-key) failed"
response=$(HTTP GET /api/rbac/context) || failed "GET /api/rbac/context with the created API-key failed"
grep -q '"smoke.test.key"' <<<"$response" ||
    failed "GET /api/rbac/context does not reflect the API-key subject but: $response"
passed

# the tooling scripts below run as child processes and inherit the global-admin provisioning
# API-key (APIKEY exports HSADMINNG_API_KEY) together with the smoke-test environment
echo "APIKEY --transient switches the HTTP function back to the provisioning API-key"
APIKEY --transient <<<"$provisioningApiKey" || failed "APIKEY --transient (provisioning API-key) failed"
passed

echo "tools/create-accounts-from-csv creates an account linking a new subject to an existing person"
personUuid=$(
    HTTP GET '/api/hs/office/persons?name=Drew' \
    | jq -r '.[0].uuid // empty'
)
[ -n "$personUuid" ] || failed "cannot resolve the test-data person 'User Drew'"
subjectUuid=$(python3 -c 'import uuid; print(uuid.uuid4())')
csvFile=build/smoke-test/accounts.csv
printf '"%s","%s","%s","%s","%s"\n' xyz-smoke.drew "$subjectUuid" Drew User "$personUuid" >"$csvFile"
tools/create-accounts-from-csv "$csvFile" 80100 || failed "tools/create-accounts-from-csv failed"
response=$(HTTP GET "/api/hs/accounts/accounts?personUuid=$personUuid") ||
    failed "GET /api/hs/accounts/accounts?personUuid=... failed"
grep -q '"xyz-smoke.drew"' <<<"$response" ||
    failed "the created account 'xyz-smoke.drew' is missing in GET /api/hs/accounts/accounts"
passed

echo "tools/create-accounts-from-csv re-run skips the already existing account (repeatable syncs)"
rerunOutput=$(tools/create-accounts-from-csv "$csvFile" 80100 2>&1) ||
    failed "the tools/create-accounts-from-csv re-run failed: $rerunOutput"
grep -q '1 already existed' <<<"$rerunOutput" ||
    failed "the re-run did not report the account as already existing but: $rerunOutput"
passed

echo "tools/create-api-key-for-keycloak-sync creates a global-admin API-key scoped to the sync endpoints"
syncApiKey=$(tools/create-api-key-for-keycloak-sync) || failed "tools/create-api-key-for-keycloak-sync failed"
grep -q '^hsak_' <<<"$syncApiKey" ||
    failed "tools/create-api-key-for-keycloak-sync did not print a clear-text API-key but: $syncApiKey"
passed

# the sync-key may list the subjects (in scope, authorized via its global-admin role) ...
echo "APIKEY --transient switches the HTTP function to the sync API-key"
APIKEY --transient <<<"$syncApiKey" || failed "APIKEY --transient (sync API-key) failed"
response=$(HTTP GET /api/rbac/subjects) || failed "GET /api/rbac/subjects with the sync API-key failed"
grep -q '"hsadminng.keycloak.sync"' <<<"$response" ||
    failed "GET /api/rbac/subjects does not contain the sync subject but: $response"
passed

# ... and the openly accessible context endpoint reflects the sync endpoint-scope ...
response=$(HTTP GET /api/rbac/context) || failed "GET /api/rbac/context with the sync API-key failed"
grep -q '"rbac.subjects:sync"' <<<"$response" ||
    failed "GET /api/rbac/context does not reflect the sync endpoint-scope but: $response"
passed

# ... which forbids all other endpoints (fail-closed), despite the global-admin role
response=$(HTTP GET /api/rbac/roles 2>/dev/null) &&
    failed "GET /api/rbac/roles with the sync API-key succeeded despite its endpoint-scope: $response"
passed

# There is no backend server to ssh into here, so a stubbed ssh runs the remote script locally
# against the throw-away database. The stub reproduces ssh's argument flattening, which is
# exactly what the SQL has to survive: unquoted it would reach psql as a mere `select`.
echo "tools/remote backend sql runs a complete SQL statement through ssh's argument flattening"
sshStubDir=build/smoke-test/ssh-stub
fakeServerHome=build/smoke-test/fake-server-home
mkdir -p "$sshStubDir" "$fakeServerHome/backend"
cat >"$sshStubDir/ssh" <<'SSH_STUB'
#!/bin/bash
while [ $# -gt 0 ]; do case "$1" in -t|-T|-q) shift ;; *) break ;; esac; done
shift # the user@host argument
export HOME=$SMOKE_TEST_FAKE_SERVER_HOME
exec bash -c "$*"
SSH_STUB
chmod +x "$sshStubDir/ssh"
cat >"$fakeServerHome/backend/.environment" <<ENVIRONMENT_FILE
SPRING_DATASOURCE_URL=$HSADMINNG_POSTGRES_JDBC_URL
SPRING_DATASOURCE_USERNAME=$HSADMINNG_POSTGRES_ADMIN_USERNAME
SPRING_DATASOURCE_PASSWORD=$HSADMINNG_POSTGRES_ADMIN_PASSWORD
ENVIRONMENT_FILE
# the statement carries a space, a star, parentheses and quotes, all of which a remote
# login-shell would mangle without proper quoting
# stderr captured as well, so a failure message names its cause instead of staying empty
response=$(
    SMOKE_TEST_FAKE_SERVER_HOME=$(cd "$fakeServerHome" && pwd) \
    PATH=$(cd "$sshStubDir" && pwd):$PATH \
    HSADMINNG_DEPLOY_HOST=stubbed \
    tools/remote backend sql "select count(*) from rbac.subject where name = '$HSADMINNG_SUPERUSER'" 2>&1
) || failed "tools/remote backend sql failed: $response"
grep -qx 1 <<<"$response" ||
    failed "tools/remote backend sql did not count the subject '$HSADMINNG_SUPERUSER' but answered: $response"
passed

# A security incident must alert immediately, even while an ordinary outage alarm is already
# backing off, so each alarm needs its own state file. Sourcing the checker with
# HSADMINNG_LOGIN_MONITOR_DEFINE_ONLY yields its functions without performing a real check.
echo "tools/login-monitoring-check alerts a critical incident despite a running failure backoff"
monitorStateDir=build/smoke-test/monitor-state
rm -rf "$monitorStateDir"
mkdir -p "$monitorStateDir"
alarmProbe=$(
    HSADMINNG_LOGIN_MONITOR_DEFINE_ONLY=true \
    HSADMINNG_LOGIN_MONITOR_PASSWORD=irrelevant-for-this-probe \
    HSADMINNG_LOGIN_MONITOR_STATE_FILE="$monitorStateDir/login-monitoring-check.state" \
    bash -c '
        source tools/login-monitoring-check
        MATRIX_WEBHOOK_URL=https://example.invalid/webhook
        # no Matrix here, just record what would have been sent
        sendMatrixMessage() { echo "WOULD-SEND severity=$2"; }
        # a failure alarm which has already backed off to its longest interval
        now=$(date +%s)
        printf "FIRST_FAILURE_TS=%s\nLAST_ALERT_TS=%s\nALERT_COUNT=6\n" \
            $((now - 115200)) $((now - 3600)) >"$STATE_FILE"
        critical "monitoring user unexpectedly has 3 role grant(s)"
    ' 2>&1
) || true
grep -q 'WOULD-SEND severity=critical' <<<"$alarmProbe" ||
    failed "the critical alert was swallowed by the running failure backoff: $alarmProbe"
# a critical check is only reachable when login works, so the failure alarm must be closed
# along the way -- a stale state from the formerly shared file would fake a later login-RESOLVED
grep -q 'WOULD-SEND severity=ok' <<<"$alarmProbe" ||
    failed "the pending failure alarm was not closed when the critical alert fired: $alarmProbe"
[ ! -f "$monitorStateDir/login-monitoring-check.state" ] ||
    failed "the failure state file survived the critical alert and could fake a later RESOLVED"
passed

# The subject is created before the global-admin role is resolved, so a failure in between must
# be diagnosed rather than kill the script silently: the operator has to learn about the subject
# left behind, otherwise the rerun only reports 'already exists'. The failure is injected by a jq
# which fails for exactly that lookup.
echo "tools/create-api-key-for-keycloak-sync reports the subject it left behind on a failed role-lookup"
# back to the unrestricted provisioning API-key, the sync-key may not create subjects
APIKEY --transient <<<"$provisioningApiKey" || failed "APIKEY --transient (provisioning API-key) failed"
jqStubDir=build/smoke-test/jq-stub
mkdir -p "$jqStubDir"
cat >"$jqStubDir/jq" <<JQ_STUB
#!/bin/bash
for arg in "\$@"; do
    case "\$arg" in *'.[0].uuid'*) exit 1 ;; esac
done
exec $(command -v jq) "\$@"
JQ_STUB
chmod +x "$jqStubDir/jq"
response=$(
    PATH=$(cd "$jqStubDir" && pwd):$PATH \
    tools/create-api-key-for-keycloak-sync smoke.test.halfway.key 2>&1
) && failed "create-api-key-for-keycloak-sync succeeded despite the failing role-lookup: $response"
grep -q 'delete that subject before retrying' <<<"$response" ||
    failed "the failed role-lookup did not name the subject left behind but: $response"
passed

echo
echo "SMOKE-TEST PASSED"
