#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "-?" || "${1:-}" == "--help" ]]; then
    source tools/lib/unindented.sh
    unindented <<'HELP'
        usage: tools/api-key-create [--no-local-store] <subject-name> <scope>...

        Creates an API_KEY subject with the given endpoint-scopes and grants it the global-admin
        role, in one step, then prints the clear-text API-key (once!) to stdout.

        The API-key is also stored under the subject-name in `.apikeys.gpg`, in the section of the
        current stage (HSADMINNG_API_BASE_URL), so it does not get lost, see `APIKEY --help`;
        `--no-local-store` skips this, e.g. for throw-away keys.

        The scopes restrict the key to their endpoints, the granted global-admin role authorizes
        these calls; at least one scope is required, because an unscoped global-admin key may do
        anything. `HTTP GET /api/rbac/scopes` lists the available scopes, e.g.:
          tools/api-key-create hsadminng.keycloak.sync rbac.subjects:sync
          tools/api-key-create hsadminng.billing.mda hs.office:billing-mda

        Backend and credentials come from the personal '.environment' (the stage selection,
        e.g. copied from '.environment-int-remote'), which this tool sources via '.aliases'.
        Values exported in the calling shell win, though, e.g. by 'APIKEY <name>' or 'LOGIN'
        done there as a global-admin.

        The clear-text API-key is a secret, returned only in this creation response and never
        retrievable again -- capture it, e.g.:
          apiKey=$(tools/api-key-create hsadminng.billing.mda hs.office:billing-mda)
HELP
    exit 0
fi

store=yes
if [[ "${1:-}" == "--no-local-store" ]]; then
    store=no
    shift
fi
if [[ $# -lt 2 || -z "$1" ]]; then
    echo "ERROR: expected <subject-name> and at least one <scope>, see --help" >&2
    exit 1
fi

# run from the repository root, because the HTTP function calls `tools/http` via a relative path
cd "$(dirname "$0")/.." || exit 1

subjectName="$1"
shift
scopesJson=$(jq -cn '$ARGS.positional' --args "$@")
globalAdminRole="rbac.global#global:ADMIN"

# brings in the HTTP function and, with it, the stage selected in the personal `.environment`,
# whose defaults must not override what the calling shell exported, e.g. via APIKEY or LOGIN
externalApiBaseUrl=${HSADMINNG_API_BASE_URL:-}
externalApiKey=${HSADMINNG_API_KEY:-}
externalJwtBearer=${HSADMINNG_JWT_BEARER:-}
# shellcheck source=/dev/null
source .aliases
[ -n "$externalApiBaseUrl" ] && export HSADMINNG_API_BASE_URL=$externalApiBaseUrl
[ -n "$externalApiKey" ] && export HSADMINNG_API_KEY=$externalApiKey
[ -n "$externalJwtBearer" ] && export HSADMINNG_JWT_BEARER=$externalJwtBearer
# an API-key from the calling shell must not lose against a JWT from .environment, which tools/http prefers
[ -n "$externalApiKey" ] && [ -z "$externalJwtBearer" ] && unset HSADMINNG_JWT_BEARER

if [ -z "${HSADMINNG_API_KEY:-}" ] && [ -z "${HSADMINNG_JWT_BEARER:-}" ]; then
    echo "ERROR: not authenticated; run APIKEY <name> or LOGIN as a global-admin first (see .aliases)" >&2
    exit 1
fi

echo "creating API_KEY subject '$subjectName' with scopes $scopesJson ..." >&2
createRc=0
created=$(
  HTTP POST /api/rbac/subjects <<JSON
  {
    "type": "API_KEY",
    "name": "$subjectName",
    "scopes": $scopesJson
  }
JSON
) || createRc=$?
if [ "$createRc" -ne 0 ]; then
    if grep -Eq '"statusCode" *: *409' <<<"$created"; then
        echo "ERROR: subject '$subjectName' already exists; its API-key cannot be recovered -- delete it first" >&2
    else
        echo "ERROR: could not create the API_KEY subject:" >&2
        printf '%s\n' "$created" >&2
    fi
    exit 1
fi

subjectUuid=$(jq -r '.uuid // empty' <<<"$created")
apiKey=$(jq -r '.apiKey // empty' <<<"$created")
if [ -z "$subjectUuid" ] || [ -z "$apiKey" ]; then
    echo "ERROR: creation response lacked uuid or apiKey:" >&2
    printf '%s\n' "$created" >&2
    exit 1
fi

echo "resolving the '$globalAdminRole' role UUID ..." >&2
globalAdminRoleUriEncoded="${globalAdminRole/\#/%23}"
# the guard keeps `set -e` from killing the script before the diagnosis below, which has to
# name the already created subject, or its rerun dead-ends in the 'already exists' branch
roleUuid=$(
  HTTP GET "/api/rbac/roles?name=$globalAdminRoleUriEncoded" \
  | jq -r '.[0].uuid // empty'
) || roleUuid=
if [ -z "$roleUuid" ]; then
    echo "ERROR: created subject $subjectUuid but could not resolve the '$globalAdminRole' role UUID;" >&2
    echo "       delete that subject before retrying" >&2
    exit 1
fi

# the DB grants only if exactly the granted role is assumed, thus assume it via the header
echo "granting the global-admin role to '$subjectName' ..." >&2
grantRc=0
grantResponse=$(
  HTTP POST /api/rbac/grants \
    -H "Hostsharing-Assumed-Roles: $globalAdminRole" <<JSON
  {
    "assumed": true,
    "grantedRole.uuid": "$roleUuid",
    "granteeSubject.uuid": "$subjectUuid"
  }
JSON
) || grantRc=$?
if [ "$grantRc" -ne 0 ]; then
    echo "ERROR: created subject $subjectUuid but could not grant the global-admin role:" >&2
    printf '%s\n' "$grantResponse" >&2
    exit 1
fi

echo "created API_KEY subject $subjectUuid ('$subjectName') and granted it the global-admin role." >&2

if [ "$store" == yes ]; then
    stage="${HSADMINNG_API_BASE_URL:-}"; stage="${stage%/}"
    if tools/lib/apikeys-file.py store "$stage" "$subjectName" <<<"$apiKey"; then
        echo "stored the API-key as '$subjectName' for [$stage] in .apikeys.gpg." >&2
    else
        echo "WARNING: could not store the API-key in .apikeys.gpg -- keep the one printed below!" >&2
    fi
fi
echo "clear-text API-key (shown only once) follows on stdout:" >&2
printf '%s\n' "$apiKey"
