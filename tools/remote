#!/usr/bin/env bash
# Commands for the remote backend server (see HSADMINNG_DEPLOY_HOST).
#
# Usage: remote <target> <action> [ARGS]
#
# Backend service (systemd user unit: backend):
#   remote backend deploy [--backend|--ansible] [--with-documentation]
#                                     build & deploy the local working-tree jar;
#                                     --backend (default): upload to the backend user, restart the
#                                     systemd service and stream the startup log until the
#                                     application reports it has started;
#                                     --ansible: upload the jar for the Ansible reset, which installs
#                                     it, RE-INITIALIZES the database from ~/db-dumps/ and restarts
#                                     the service (its command is not wired up yet);
#                                     --with-documentation renders the documentation into the jar
#                                     instead of the /doc/ placeholder page (needs pandoc,
#                                     mermaid-filter, pandoc-plantuml and the Testcontainers
#                                     database for scenarioTest)
#   remote backend upload [--backend|--ansible] [--with-documentation]
#                                     build the jar like deploy, but only upload it, without restart:
#                                     --ansible (default) into ~/jar/ of the ansible user,
#                                     --backend into ~/backend/ of the backend user, where it
#                                     becomes active with the next service restart
#   remote backend start              start the backend service
#   remote backend stop               stop the backend service
#   remote backend restart            restart the backend service
#   remote backend status             show the backend service status
#   remote backend enable             enable and start the backend service (--now)
#   remote backend disable            disable and stop the backend service (--now)
#   remote backend log [ARGS]         tail the backend log (extra ARGS go to tail)
#   remote backend setup              install (or refresh) the backend systemd user unit, a jar runner
#                                     after the hsh11 model; expects ~/backend/.environment (chmod 600,
#                                     incl. SPRING_PROFILES_ACTIVE) and a JDK 21 under ~/opt/jdk-21
#   remote backend provision-api-key [--force] [--no-local-store]
#                                     generate an API-key locally and provision just its hash on the server;
#                                     the API-key is stored in .apikeys.gpg for HSADMINNG_API_BASE_URL,
#                                     unless --no-local-store is given;
#                                     --force first deletes the API_KEY subject hsadminng.provisioning.key and
#                                     its configured hash, e.g. to recover from a lost provisioning API-key;
#                                     as a safeguard against the wrong stage, it asks to type the stage name
#   remote backend sql [SQL]          run SQL on the backend database with its own datasource credentials;
#                                     with SQL runs that statement, otherwise opens psql or reads SQL from stdin
#   remote backend sql-tunnel [PORT]  forward a local port (default 15432) to the backend database and print
#                                     the connection parameters, so a local SQL GUI can edit it (Ctrl-C closes)
#
# Login-monitor (systemd user units: login-monitoring-check.{service,timer}):
#   remote login-monitor deploy       install (or refresh) the monitoring timer (see notes)
#   remote login-monitor run          run the monitoring check once now
#   remote login-monitor start        start the monitoring timer (resume monitoring)
#   remote login-monitor stop         stop the monitoring timer (pause monitoring)
#   remote login-monitor restart      restart the monitoring timer
#   remote login-monitor status       show the timer status, schedule and last check result
#   remote login-monitor alerts       list the alerts currently active (from the monitor's state files)
#   remote login-monitor enable       enable and start the monitoring timer (--now)
#   remote login-monitor disable      disable and stop the monitoring timer (--now)
#   remote login-monitor log [ARGS]   tail the monitoring log (extra ARGS go to tail)
#
# Host:
#   remote ssh [--backend|--ansible] [CMD]
#                                     open a shell or run CMD on the server, by default as the
#                                     backend user, with --ansible as the ansible user
#   remote upload <file> <directory>  copy a local file into <directory> of the ansible user's
#                                     home, renamed into place only after a complete transfer
#
# Notes: HSADMINNG_DEPLOY_HOST names the bare deploy host (e.g. hsh03); the tool derives
# the logins <host>-backend (service, database, logs) and <host>-ansible, whose ~/jar/ and
# ~/db-dumps/ are the staging areas for the Ansible-based deployment.
# `login-monitor deploy` reads its secrets and the optional interval
# from ~/.environment on the server; see doc/environment-variables.md.
#
# This deploys the local working state to a test stage for unmerged changes only;
# regular releases go via the CI/CD pipeline.
set -euo pipefail

# strips the indentation off the remote scripts below; an absolute path, because unlike the
# other tools this one is meant to be called from anywhere (see .envrc)
# shellcheck source=lib/unindented.sh
source "$(dirname "$0")/lib/unindented.sh"

# deliberately no default host: a deploy tool must never guess its target stage
HSADMINNG_DEPLOY_HOST=${HSADMINNG_DEPLOY_HOST:-}
JAR_NAME='hsadmin-ng-0.0.1-SNAPSHOT.jar'
STARTUP_LOG_TIMEOUT_SECONDS=300
STARTUP_SETTLE_SECONDS=2 # systemd needs a moment until is-active reflects a just-failed startup

requireDeployHost() {
    [ -n "$HSADMINNG_DEPLOY_HOST" ] || {
        echo "ERROR: HSADMINNG_DEPLOY_HOST is not set, and there is deliberately no default;" >&2
        echo "       export HSADMINNG_DEPLOY_HOST=<host> for the intended stage first, e.g. hsh03;" >&2
        echo "       the tool logs in as <host>-backend resp. <host>-ansible" >&2
        exit 1
    }
    case "$HSADMINNG_DEPLOY_HOST" in
        *@*)
            echo "ERROR: HSADMINNG_DEPLOY_HOST must name just the host (e.g. hsh03), no longer user@host;" >&2
            echo "       the users <host>-backend and <host>-ansible are derived from it" >&2
            exit 1 ;;
    esac
    local hostName=${HSADMINNG_DEPLOY_HOST%%.*}
    backendLogin="$hostName-backend@$HSADMINNG_DEPLOY_HOST"
    ansibleLogin="$hostName-ansible@$HSADMINNG_DEPLOY_HOST"
}

# prints the whole header comment (all # lines up to `set -euo pipefail`)
usage() {
    awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"
}

# runs a command with output captured and stdin detached,
# prints just one line unless the command fails
# (also defined in the remote script below, keep both in sync)
step() {
    local message=$1; shift
    echo -n "$message: $* ... "
    local output rc=0
    output=$("$@" </dev/null 2>&1) || rc=$?
    if [ "$rc" -eq 0 ]; then
        echo "done"
    else
        echo "FAILED (exit code $rc)"
        printf '%s\n' "$output"
        exit "$rc"
    fi
}

# the systemd user unit a target's lifecycle verbs (start/stop/...) act on;
# for the login-monitor this is the timer, while `run` triggers the .service
unitOf() {
    case "$1" in
        backend)       echo backend ;;
        login-monitor) echo login-monitoring-check.timer ;;
    esac
}

# thin passthrough for the systemd lifecycle verbs, uniform across both targets
lifecycle() { # $1=target  $2=verb
    local unit; unit=$(unitOf "$1")
    case "$2" in
        enable|disable) ssh "$backendLogin" systemctl --user "$2" --now "$unit" ;;
        status)         exec ssh -t "$backendLogin" systemctl --user status "$unit" ;;
        *)              ssh "$backendLogin" systemctl --user "$2" "$unit" ;;
    esac
}

# tails a remote logfile; $1 is the logfile, remaining args are passed to tail
cmdLog() {
    local logfile=$1; shift
    exec ssh -t "$backendLogin" tail -f "$@" "$logfile"
}

# a tty only where there is one, so a scripted caller does not get ssh's warning about it
cmdSsh() {
    local login=$backendLogin
    case "${1:-}" in
        --backend) shift ;;
        --ansible) login=$ansibleLogin; shift ;;
    esac
    local ttyOpt=-t; [ -t 0 ] || ttyOpt=
    exec ssh $ttyOpt "$login" "$@"
}

# Builds the jar from the local working tree; unlike the former push-and-build-on-the-server
# flow, uncommitted changes are thus INCLUDED. Warns about uncommitted files and unpushed
# commits, but continues if confirmed. Sets `branch` for the caller's messages.
buildBackendJar() { # args: [--with-documentation]
    cd "$(dirname "$0")/.." # the local build needs to run in the repo root

    local withDocumentation=
    if [ "${1:-}" = "--with-documentation" ]; then
        withDocumentation=1
        shift
    fi
    if [ $# -gt 0 ]; then
        echo "ERROR: unknown argument: $1" >&2
        usage >&2
        exit 1
    fi
    if [ -n "$withDocumentation" ]; then
        # fail before the build, a missing render tool would otherwise only fail deep inside pandoc
        local renderTool
        for renderTool in pandoc mermaid-filter pandoc-plantuml; do
            command -v "$renderTool" >/dev/null || {
                echo "ERROR: '$renderTool' is required to render the documentation into the jar" >&2
                exit 1
            }
        done
    fi

    branch=$(git rev-parse --abbrev-ref HEAD)
    if [ "$branch" = "HEAD" ]; then
        echo "ERROR: detached HEAD, please check out a branch" >&2
        exit 1
    fi

    local warnings=0

    if [ -n "$(git status --porcelain)" ]; then
        echo "WARNING: there are uncommitted changes which WILL be deployed:"
        git status --short
        warnings=1
    fi

    local upstream unpushed
    if upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null); then
        unpushed=$(git rev-list --count "$upstream..HEAD")
        if [ "$unpushed" -gt 0 ]; then
            echo "WARNING: $unpushed commit(s) not yet pushed to $upstream (they WILL be deployed):"
            git log --oneline "$upstream..HEAD"
            warnings=1
        fi
    else
        echo "WARNING: branch '$branch' has no upstream, deploying a state not tracked on any remote"
        warnings=1
    fi

    if [ "$warnings" -ne 0 ]; then
        local answer
        read -r -p "Continue deployment of branch '$branch' anyway? [y/N] " answer
        case "$answer" in
            [yY]|[yY][eE][sS]) ;;
            *) echo "Deployment aborted."; exit 1 ;;
        esac
    fi

    # remove old jars to make sure we never deploy a stale build
    step "removing previously built jars" bash -c 'rm -f build/libs/hsadmin-ng-*.jar'
    if [ -n "$withDocumentation" ]; then
        # scenarioTest renders the bundled reports and needs the Testcontainers database;
        # a dataset HSADMINNG_POSTGRES_JDBC_URL from the calling shell must not leak in,
        # the scenarios would end up in that dataset (same subshell idiom as tools/demo-data)
        step "building the application locally, documentation included" bash -c '
            unset HSADMINNG_POSTGRES_JDBC_URL
            source .tc-environment
            ./gradlew scenarioTest bootJar -PincludeRenderedDocumentation=true -PincludeBuildTime=true'
    else
        step "building the application locally" ./gradlew build -x dependencyCheckAnalyze -x compileTestJava -x test -x jacocoTestReport -x jacocoTestCoverageVerification -x spotlessJavaCheck -PincludeBuildTime=true
    fi

    # without git.properties (e.g. built in a git worktree), the deployed version
    # would not be identifiable via /actuator/info
    local versionInfo
    versionInfo=$(unzip -p "build/libs/$JAR_NAME" BOOT-INF/classes/git.properties 2>/dev/null |
        grep -E '^git\.(branch|commit\.id\.abbrev|dirty)=' || true)
    if [ -z "$versionInfo" ]; then
        echo "ERROR: the built jar contains no git version info (git.properties)," >&2
        echo "       e.g. when building in a git worktree; refusing to deploy it" >&2
        exit 1
    fi
    echo "built version info:"
    sed 's/^/    /' <<<"$versionInfo"
}

# Splits the shared deploy/upload arguments: --backend/--ansible set the (global) deployTarget,
# everything else stays in (global) buildArgs for buildBackendJar.
parseDeployTarget() { # $1=default target, remaining args as given by the user
    deployTarget=$1; shift
    buildArgs=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --backend) deployTarget=backend ;;
            --ansible) deployTarget=ansible ;;
            *)         buildArgs+=("$1") ;;
        esac
        shift
    done
}

# The uploaded jar is activated by an atomic rename, so the running service keeps
# its old jar until the next restart.
uploadJarToBackendUser() {
    step "uploading the jar to $backendLogin" \
        scp -q "build/libs/$JAR_NAME" "$backendLogin:backend/$JAR_NAME.upload"
    step "activating the uploaded jar" \
        ssh "$backendLogin" mv "backend/$JAR_NAME.upload" "backend/$JAR_NAME"
}

# The Ansible reset installs the staged jar, RE-INITIALIZES the database from ~/db-dumps/
# and restarts the service; its command comes from Ops and is not wired up yet.
ansibleReset() {
    echo "ERROR: the jar is staged, but this tool does not know the Ansible reset command yet;" >&2
    echo "       run the Ansible deployment manually as $ansibleLogin" >&2
    exit 1
}

# Deploys the freshly built jar: --backend (default) uploads it to the backend user and
# restarts the systemd service; --ansible uploads it and hands over to the Ansible reset.
# Prints one line per step; full command output is only shown if a step fails.
cmdBackendDeploy() {
    parseDeployTarget backend "$@"
    buildBackendJar "${buildArgs[@]}"

    if [ "$deployTarget" = ansible ]; then
        cmdUpload "build/libs/$JAR_NAME" jar
        ansibleReset
        return
    fi

    uploadJarToBackendUser

    # remember the log size before the restart, so the startup can be streamed from exactly
    # the first new line and stopped at the "Started" marker further down
    local logOffset
    logOffset=$(ssh "$backendLogin" "stat -c%s var/backend.log 2>/dev/null || echo 0")

    step "restarting the backend service" \
        ssh "$backendLogin" systemctl --user restart backend

    sleep 3
    if ssh "$backendLogin" systemctl --user --quiet is-active backend; then
        echo "backend service is active"
    else
        echo "backend service FAILED to start:"
        ssh "$backendLogin" systemctl --user --no-pager --lines=25 status backend || true
        exit 1
    fi

    # stream the startup log from where it stood right before the restart and stop as soon as
    # the application logs that it has (or has failed to) started, so the end of the — possibly
    # lengthy, Liquibase-included — startup is easy to notice; the timeout guards against an
    # indefinite hang if neither marker ever appears, and sed exiting closes the pipe so tail stops
    echo "waiting for the backend to finish starting (Ctrl-C to stop watching the log):"
    ssh -t "$backendLogin" \
        "timeout $STARTUP_LOG_TIMEOUT_SECONDS tail -f -c +$((logOffset + 1)) var/backend.log |
            sed -E '/Started HsadminNgApplication|APPLICATION FAILED TO START/q'" || true

    sleep $STARTUP_SETTLE_SECONDS
    if ssh "$backendLogin" systemctl --user --quiet is-active backend; then
        # the app answers now, so report the version it actually runs with
        ssh "$backendLogin" 'set -a; . ~/backend/.environment; set +a
            info=$(curl -s "http://localhost:${MANAGEMENT_SERVER_PORT:-8081}/actuator/info") && [ -n "$info" ] &&
                echo "running version info: $info"' || true
        echo "deployment of branch '$branch' finished, the backend has started"
    else
        echo "ERROR: the backend service is not active after startup:" >&2
        ssh "$backendLogin" systemctl --user --no-pager --lines=25 status backend >&2 || true
        exit 1
    fi
}

# Only uploads the freshly built jar, without any restart: --ansible (default) into ~/jar/
# of the ansible user for the Ansible reset, --backend into ~/backend/ of the backend user.
cmdBackendUpload() {
    parseDeployTarget ansible "$@"
    buildBackendJar "${buildArgs[@]}"

    if [ "$deployTarget" = backend ]; then
        uploadJarToBackendUser
        echo "upload of branch '$branch' finished, it becomes active with the next service restart"
    else
        cmdUpload "build/libs/$JAR_NAME" jar
        echo "upload of branch '$branch' finished, deploy it with the Ansible reset"
    fi
}

# Copies a local file into a directory of the ansible user's home, the staging area for the
# Ansible-based deployment; this command only knows the host. The upload goes to a temporary name and is
# renamed once it is complete, so an interrupted transfer leaves no half file under the real name.
cmdUpload() {
    local file=${1:-} directory=${2:-}
    if [ -z "$file" ] || [ -z "$directory" ]; then
        echo "ERROR: 'upload' needs a local file and a target directory" >&2
        usage >&2
        exit 1
    fi
    if [ ! -f "$file" ]; then
        echo "ERROR: $file does not exist" >&2
        exit 1
    fi

    # ssh, scp and mv re-parse the remote path in the remote shell, so instead of
    # quoting for each of them, only accept characters which pass through unchanged
    local component
    for component in "$directory" "$(basename "$file")"; do
        case "$component" in
            /*|-*|..|*/..|../*|*/../*|*[!A-Za-z0-9._/-]*)
                echo "ERROR: remote path '$component' must be relative, without '..'," >&2
                echo "       and contain only letters, digits and one of '._/-'" >&2
                exit 1 ;;
        esac
    done

    local target="$directory/$(basename "$file")"
    step "creating ~/$directory on $ansibleLogin" \
        ssh "$ansibleLogin" mkdir -p "$directory"
    step "uploading $file ($(du -h "$file" | cut -f1)) to $ansibleLogin" \
        scp -q "$file" "$ansibleLogin:$target.upload"
    step "renaming it into place" \
        ssh "$ansibleLogin" mv "$target.upload" "$target"
    echo "uploaded to ~/$target on $ansibleLogin"
}

# Installs (or refreshes) the backend systemd user unit on the server: the hsh11-style jar
# runner, so a new stage comes up reproducibly instead of by hand-crafted unit files.
# The prerequisites stay on the server and are only checked here: ~/backend/.environment
# carries the stage secrets, and the JDK lives under ~/opt/jdk-21 by convention.
cmdBackendSetup() {
    ssh "$backendLogin" bash -s <<'REMOTE_SCRIPT'
set -euo pipefail

[ -x "$HOME/opt/jdk-21/bin/java" ] || {
    echo "ERROR: no JDK under ~/opt/jdk-21 on the server; install e.g. Temurin 21 with:" >&2
    echo "       mkdir -p ~/opt/jdk-21 && curl -sSfL 'https://api.adoptium.net/v3/binary/latest/21/ga/linux/x64/jdk/hotspot/normal/eclipse' | tar -xz --strip-components=1 -C ~/opt/jdk-21" >&2
    exit 1
}
[ -f "$HOME/backend/.environment" ] || {
    echo "ERROR: ~/backend/.environment not found on the server;" >&2
    echo "       create it (chmod 600, systemd EnvironmentFile format) with the datasource," >&2
    echo "       server port and JWT settings; see doc/environment-variables.md" >&2
    exit 1
}
# the stage decides its profiles (e.g. fake-jwt vs. a real issuer), so they live in the
# stage's environment file, not in the unit
grep -q '^SPRING_PROFILES_ACTIVE=' "$HOME/backend/.environment" || {
    echo "ERROR: ~/backend/.environment on the server must contain a plain 'SPRING_PROFILES_ACTIVE=...' line," >&2
    echo "       e.g. SPRING_PROFILES_ACTIVE=complete,external-db,without-test-data" >&2
    exit 1
}
chmod 600 "$HOME/backend/.environment"
mkdir -p ~/var ~/.config/systemd/user

cat > ~/.config/systemd/user/backend.service <<'UNIT'
[Unit]
Description=HSAdminNG Service

[Service]
WorkingDirectory=%h/backend
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="JAVA_HOME=%h/opt/jdk-21"
Environment="HOME=%h"
Environment="LANG=de_DE.UTF-8"
EnvironmentFile=%h/backend/.environment
ExecStart=%h/opt/jdk-21/bin/java -Xms512M -Xmx512M -jar %h/backend/hsadmin-ng-0.0.1-SNAPSHOT.jar
StandardOutput=append:%h/var/backend.log
StandardError=inherit
Restart=always
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
UNIT

systemctl --user daemon-reload
systemctl --user enable backend.service
echo "backend.service installed and enabled; bring a jar with: remote backend deploy"
REMOTE_SCRIPT
}

# Generates a new API-key locally and provisions just its SHA-256 hash on the server
# (see ProvisioningApiKeyBootstrap.java and "Bootstrapping the provisioning API-key" in README.md):
# the hash is appended to the EnvironmentFile of the backend service, the service is
# restarted, and the bootstrap outcome is verified via the backend log.
# The clear-text API-key is printed at the very end; it only ever exists at the client.
cmdProvisioningApiKey() {
    local force=no store=yes
    while [ $# -gt 0 ]; do
        case "$1" in
            --force)          force=yes ;;
            --no-local-store) store=no ;;
            *)                echo "ERROR: unknown option '$1' for provision-api-key, see --help" >&2; exit 1 ;;
        esac
        shift
    done
    [ "$force" == yes ] && confirmStage
    local apiKey keyHash
    apiKey=$(tools/api-key-generate hsadminng.provisioning.key)
    keyHash=$(tools/api-key-hash "$apiKey")

    local rc=0
    ssh "$backendLogin" bash -s -- "$keyHash" "$force" < <(unindented <<'REMOTE_SCRIPT'
        set -euo pipefail
        keyHash=$1
        force=$2
        envFile="$HOME/backend/.environment"
        logFile="$HOME/var/backend.log"

        if grep -q '^HSADMINNG_PROVISIONING_API_KEY_SHA256=' "$envFile"; then
            if [ "$force" != yes ]; then
                echo "ERROR: HSADMINNG_PROVISIONING_API_KEY_SHA256 is already configured in $envFile," >&2
                echo "       use --force if you really want to replace the provisioning API-key" >&2
                exit 3
            fi
            echo "removing the configured HSADMINNG_PROVISIONING_API_KEY_SHA256 from $envFile"
            sed -i '/^HSADMINNG_PROVISIONING_API_KEY_SHA256=/d' "$envFile"
        fi

        # the bootstrap never replaces a stored API-key, thus the old subject has to go;
        # the DB only allows a subject to delete itself or a global-admin to delete it
        # deleting the subject row, not its rbac.reference: only then its BEFORE DELETE trigger drops the
        # grants in time, otherwise it depends on the FK trigger order, which differs in restored dumps
        if [ "$force" == yes ]; then
            echo "deleting the API_KEY subject hsadminng.provisioning.key, if it exists"
            (
                set -a; . "$envFile"; set +a
                url=${SPRING_DATASOURCE_URL:-${HSADMINNG_POSTGRES_JDBC_URL:?no datasource URL configured in $envFile}}
                url=${url#jdbc:}; url=${url%%\?*}
                PGPASSWORD=${SPRING_DATASOURCE_PASSWORD:-password} \
                    psql "$url" -U "${SPRING_DATASOURCE_USERNAME:-postgres}" -X -q -v ON_ERROR_STOP=1 -c "
                        do language plpgsql \$\$
                        begin
                            if exists (select 1 from rbac.subject
                                        where name = 'hsadminng.provisioning.key' and type = 'API_KEY') then
                                call base.defineContext('re-provisioning the provisioning API-key',
                                        null, 'hsadminng.provisioning.key', null);
                                delete from rbac.subject
                                        where name = 'hsadminng.provisioning.key' and type = 'API_KEY';
                            end if;
                        end \$\$;"
            ) || { echo "ERROR: could not delete the API_KEY subject hsadminng.provisioning.key" >&2; exit 5; }
        fi

        logOffset=$(stat -c%s "$logFile" 2>/dev/null || echo 0)

        echo "appending HSADMINNG_PROVISIONING_API_KEY_SHA256 to $envFile"
        echo "HSADMINNG_PROVISIONING_API_KEY_SHA256=$keyHash" >>"$envFile"
        chmod 600 "$envFile"

        echo "restarting the backend service ..."
        systemctl --user restart backend

        echo -n "waiting for the bootstrap message in the backend log "
        for _ in $(seq 60); do
            sleep 2
            if ! systemctl --user --quiet is-active backend; then
                echo
                echo "backend service FAILED to start:"
                systemctl --user --no-pager --lines=25 status backend || true
                exit 1
            fi
            newLog=$(tail -c "+$((logOffset+1))" "$logFile" 2>/dev/null || true)
            if grep -qE "already provisioned|provisioning API-key hash differs" <<<"$newLog"; then
                echo
                grep -E "already provisioned|provisioning API-key hash differs" <<<"$newLog"
                exit 2
            fi
            if grep -q "provisioned the provisioning API-key subject" <<<"$newLog"; then
                echo
                grep "provisioned the provisioning API-key subject" <<<"$newLog"
                exit 0
            fi
            echo -n .
        done
        echo
        echo "WARNING: no provisioning API-key bootstrap message found in the backend log within 120s" >&2
        exit 4
REMOTE_SCRIPT
    ) || rc=$?

    case "$rc" in
        0)  [ "$store" == yes ] && storeProvisioningApiKey "$apiKey"
            echo
            echo "the new provisioning API-key, it cannot be retrieved from the server again:"
            echo
            echo "    export HSADMINNG_API_KEY=$apiKey"
            ;;
        2)  echo "ERROR: a provisioning API-key was already provisioned in the database;" >&2
            echo "       the stored API-key takes precedence, the newly generated one is NOT valid" >&2
            exit 1
            ;;
        3|5) exit 1
            ;;
        *)  echo "WARNING: could not confirm the provisioning, check with '$0 backend log';" >&2
            echo "if the bootstrap succeeds on a later start, this is the matching API-key:" >&2
            echo
            echo "    export HSADMINNG_API_KEY=$apiKey"
            exit "$rc"
            ;;
    esac
}

# --force deletes the valid provisioning API-key of a stage, thus it must not hit the wrong one
confirmStage() {
    local stage=${HSADMINNG_API_BASE_URL:-}; stage=${stage%/}
    if [ -z "$stage" ]; then
        echo "ERROR: HSADMINNG_API_BASE_URL is not set, but --force needs it to confirm the stage" >&2
        exit 1
    fi
    echo "This replaces the provisioning API-key of the stage $stage on host $HSADMINNG_DEPLOY_HOST."
    local typedStage
    read -r -p "To confirm, type the stage name exactly as shown: " typedStage
    if [ "$typedStage" != "$stage" ]; then
        echo "ERROR: '$typedStage' does not match '$stage', nothing changed" >&2
        exit 1
    fi
}

# keeps the new key, because the clear-text API-key cannot be retrieved again
storeProvisioningApiKey() { # $1=apiKey
    local stage=${HSADMINNG_API_BASE_URL:-}; stage=${stage%/}
    if [ -z "$stage" ]; then
        echo "WARNING: HSADMINNG_API_BASE_URL is not set, thus the API-key is NOT stored in .apikeys.gpg" >&2
        return
    fi
    # .apikeys.gpg lives in the repository root, but this tool may be called from anywhere
    if (cd "$(dirname "$0")/.." && tools/lib/apikeys-file.py store "$stage" hsadminng.provisioning.key <<<"$1"); then
        echo "stored the API-key as 'hsadminng.provisioning.key' for [$stage] in .apikeys.gpg"
    else
        echo "WARNING: could not store the API-key in .apikeys.gpg -- keep the one printed below!" >&2
    fi
}

# Runs SQL against the backend database using the backend service's own datasource
# credentials from ~/backend/.environment (SPRING_DATASOURCE_*, falling back to the
# application.yml defaults). With a SQL argument it runs that single statement
# (ON_ERROR_STOP, unaligned pipe-separated output); with none it opens an interactive
# psql session, or pipes SQL from stdin when stdin is not a terminal. The JDBC-URL is
# reduced to a libpq URI: the `jdbc:` prefix and any `?...` query-parameters (e.g.
# currentSchema) are stripped, so address objects schema-qualified (e.g. rbac.grant).
cmdBackendSql() {
    if [ "$#" -gt 0 ]; then
        # ssh joins its command arguments into one string which the remote login-shell parses
        # again, so the SQL has to survive that second parsing round: unquoted, `select * from x`
        # would reach psql as just `select`, with the `*` expanded against the remote home
        ssh "$backendLogin" "bash -s -- $(printf '%q' "$*")" < <(unindented <<'REMOTE_SCRIPT'
            set -uo pipefail
            sql=$1
            set -a; . "$HOME/backend/.environment"; set +a
            url=${SPRING_DATASOURCE_URL:-${HSADMINNG_POSTGRES_JDBC_URL:?no datasource URL configured in ~/backend/.environment}}
            url=${url#jdbc:}; url=${url%%\?*}
            psql --version >&2 || { echo "no working psql on $(hostname)" >&2; exit 127; }
            # -X ignores any server-side ~/.psqlrc; -A gives unaligned output (no border/separator lines)
            PGPASSWORD=${SPRING_DATASOURCE_PASSWORD:-password} \
                psql "$url" -U "${SPRING_DATASOURCE_USERNAME:-postgres}" -X -A -P pager=off -v ON_ERROR_STOP=1 -c "$sql"
            rc=$?
            [ "$rc" -ne 0 ] && echo "psql exited with code $rc" >&2
            exit "$rc"
REMOTE_SCRIPT
        )
        return
    fi

    # no SQL argument: keep the remote script as a single ssh argument so stdin stays
    # free for an interactive session (tty) or for SQL piped in (no tty)
    local ttyOpt=-t; [ -t 0 ] || ttyOpt=
    exec ssh $ttyOpt "$backendLogin" '
        set -euo pipefail
        set -a; . "$HOME/backend/.environment"; set +a
        url=${SPRING_DATASOURCE_URL:-${HSADMINNG_POSTGRES_JDBC_URL:?no datasource URL configured in ~/backend/.environment}}
        url=${url#jdbc:}; url=${url%%\?*}
        PGPASSWORD=${SPRING_DATASOURCE_PASSWORD:-password} \
            exec psql "$url" -U "${SPRING_DATASOURCE_USERNAME:-postgres}" -X
    '
}

# Forwards a local port to the backend database over SSH so it can be edited with a
# local SQL GUI (or local psql). Reads the DB host/port/name/credentials from the
# backend's ~/backend/.environment (SPRING_DATASOURCE_*), prints the local connection
# parameters, then holds the tunnel in the foreground until Ctrl-C. The credentials are
# printed to stderr (this terminal only), as a local GUI needs them.
cmdBackendSqlTunnel() {
    local localPort=${1:-15432}

    # one round trip to resolve the datasource host/port/name/user/password
    local params
    params=$(ssh "$backendLogin" bash -s < <(unindented <<'REMOTE_SCRIPT'
        set -euo pipefail
        set -a; . "$HOME/backend/.environment"; set +a
        url=${SPRING_DATASOURCE_URL:-${HSADMINNG_POSTGRES_JDBC_URL:?no datasource URL configured in ~/backend/.environment}}
        u=${url#jdbc:postgresql://}; hostport=${u%%/*}; rest=${u#*/}
        printf '%s\n' \
            "${hostport%%:*}" \
            "$([ "$hostport" = "${hostport##*:}" ] && echo 5432 || echo "${hostport##*:}")" \
            "${rest%%\?*}" \
            "${SPRING_DATASOURCE_USERNAME:-postgres}" \
            "${SPRING_DATASOURCE_PASSWORD:-password}"
REMOTE_SCRIPT
    ))
    local dbHost dbPort dbName dbUser dbPass
    { read -r dbHost; read -r dbPort; read -r dbName; read -r dbUser; read -r dbPass; } <<<"$params"

    cat >&2 <<INFO
tunnel: localhost:$localPort -> $dbHost:$dbPort (via $backendLogin)
connect your SQL GUI (or: psql "postgresql://$dbUser@localhost:$localPort/$dbName") to:
    host:     localhost
    port:     $localPort
    database: $dbName
    username: $dbUser
    password: $dbPass
keep this command running; press Ctrl-C to close the tunnel
INFO

    exec ssh -N -L "$localPort:$dbHost:$dbPort" "$backendLogin"
}

# Installs (or refreshes) a systemd user timer on the backend server which runs
# the local version of tools/login-monitoring-check every 5 minutes with Matrix
# alerting. The secrets are NOT deployed by this command: ~/.environment on the server
# must already contain HSADMINNG_LOGIN_MONITOR_PASSWORD and HSADMINNG_MATRIX_WEBHOOK_URL
# (plain VAR=value lines, systemd EnvironmentFile format).
cmdMonitorDeploy() {
    local toolsDir
    toolsDir=$(cd "$(dirname "$0")" && pwd)

    step "creating the remote monitoring directory" \
        ssh "$backendLogin" mkdir -p monitoring
    step "copying tools/login-monitoring-check to $backendLogin" \
        scp -q "$toolsDir/login-monitoring-check" "$backendLogin:monitoring/"

    echo "installing the login-monitoring-check timer on $backendLogin ..."

    ssh "$backendLogin" bash -s < <(unindented <<'REMOTE_SCRIPT'
        set -euo pipefail

        # same helper as in the local part of the script, keep both in sync
        step() {
            local message=$1; shift
            echo -n "$message: $* ... "
            local output rc=0
            output=$("$@" </dev/null 2>&1) || rc=$?
            if [ "$rc" -eq 0 ]; then
                echo "done"
            else
                echo "FAILED (exit code $rc)"
                printf '%s\n' "$output"
                exit "$rc"
            fi
        }

        if [ ! -f .environment ]; then
            echo "ERROR: ~/.environment not found on the server;" >&2
            echo "       create it (chmod 600) with at least HSADMINNG_LOGIN_MONITOR_PASSWORD and HSADMINNG_MATRIX_WEBHOOK_URL" >&2
            exit 1
        fi
        for var in HSADMINNG_LOGIN_MONITOR_PASSWORD HSADMINNG_MATRIX_WEBHOOK_URL; do
            grep -qE "^$var=" .environment || {
                echo "ERROR: ~/.environment on the server must contain a plain '$var=...' line" >&2
                echo "       (systemd EnvironmentFile format: no 'export', no shell expansions)" >&2
                exit 1
            }
        done
        interval=$(sed -n 's/^HSADMINNG_LOGIN_MONITOR_INTERVAL_MINUTES=//p' .environment | tail -1)
        interval=${interval:-5}
        if ! [[ "$interval" =~ ^[0-9]+$ ]] || [ "$interval" -lt 1 ] || [ "$interval" -gt 59 ]; then
            echo "ERROR: HSADMINNG_LOGIN_MONITOR_INTERVAL_MINUTES in ~/.environment must be an integer from 1 to 59, got '$interval'" >&2
            exit 1
        fi

        chmod 600 .environment
        chmod 700 monitoring/login-monitoring-check
        mkdir -p var .config/systemd/user

        cat >.config/systemd/user/login-monitoring-check.service <<'UNIT'
        [Unit]
        Description=hsadmin-NG login-monitoring-check

        [Service]
        Type=oneshot
        TimeoutStartSec=120
        EnvironmentFile=%h/.environment
        ExecStart=%h/monitoring/login-monitoring-check --matrix-webhook
        StandardOutput=append:%h/var/login-monitoring.log
        StandardError=inherit
        UNIT

        cat >.config/systemd/user/login-monitoring-check.timer <<UNIT
        [Unit]
        Description=hsadmin-NG login-monitoring-check every $interval minutes

        [Timer]
        OnCalendar=*:0/$interval

        [Install]
        WantedBy=timers.target
        UNIT

        step "reloading the systemd user daemon" systemctl --user daemon-reload
        step "enabling and starting the timer" systemctl --user enable --now login-monitoring-check.timer

        echo -n "running the first check now ... "
        if systemctl --user start login-monitoring-check.service </dev/null; then
            echo "done: $(tail -1 var/login-monitoring.log)"
        else
            echo "FAILED:"
            tail -25 var/login-monitoring.log
            exit 1
        fi
        systemctl --user list-timers login-monitoring-check.timer --no-pager
REMOTE_SCRIPT
    )
}

# Runs the monitoring check once now (the oneshot .service, not the timer) and
# reports the last log line; on failure it shows the tail of the log.
cmdMonitorRun() {
    if ssh "$backendLogin" systemctl --user start login-monitoring-check.service </dev/null; then
        ssh "$backendLogin" tail -1 var/login-monitoring.log
    else
        echo "check FAILED:" >&2
        ssh "$backendLogin" tail -25 var/login-monitoring.log >&2
        exit 1
    fi
}

# Lists the alerts the monitor currently holds active. An alert is active exactly while its
# state file exists (the checker removes it on RESOLVED), so this reads the three state files
# the checker uses and reports each active one with since/count/next-due. The state-file path
# and backoff are resolved from ~/.environment just as the checker's defaults do.
cmdMonitorAlerts() {
    ssh "$backendLogin" bash -s < <(unindented <<'REMOTE_SCRIPT'
        set -uo pipefail
        [ -f .environment ] && { set -a; . ./.environment; set +a; }

        stateFile=${HSADMINNG_LOGIN_MONITOR_STATE_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/login-monitoring-check.state}
        alarmRepeat=${HSADMINNG_LOGIN_MONITOR_ALARM_REPEAT:-1,2,4,8,16,24}
        # mirror the checker's fallback, so an invalid value cannot crash the arithmetic below
        [[ "$alarmRepeat" =~ ^[0-9]+(,[0-9]+)*$ ]] || alarmRepeat=1,2,4,8,16,24
        now=$(date +%s)
        found=0

        fmtAgo() { # $1=seconds
            local s=$1
            if   [ "$s" -ge 86400 ]; then printf '%dd%dh' $((s/86400)) $((s%86400/3600))
            elif [ "$s" -ge 3600 ];  then printf '%dh%dm' $((s/3600)) $((s%3600/60))
            elif [ "$s" -ge 60 ];    then printf '%dm%ds' $((s/60)) $((s%60))
            else printf '%ds' "$s"; fi
        }

        report() { # $1=label  $2=stateFile
            local label=$1 file=$2
            [ -f "$file" ] || return 0
            found=1
            local FIRST_FAILURE_TS='' LAST_ALERT_TS=0 ALERT_COUNT=0
            . "$file"
            local gaps; IFS=, read -ra gaps <<<"$alarmRepeat"
            local idx=$(( ALERT_COUNT <= ${#gaps[@]} ? ALERT_COUNT - 1 : ${#gaps[@]} - 1 ))
            [ "$idx" -lt 0 ] && idx=0
            local dueTs=$(( LAST_ALERT_TS + gaps[idx] * 3600 ))
            printf '%-14s active since %s (%s ago), %s alert(s), last %s, next due %s\n' \
                "$label" \
                "$(date -d "@$FIRST_FAILURE_TS" '+%F %T')" "$(fmtAgo $(( now - FIRST_FAILURE_TS )))" \
                "$ALERT_COUNT" \
                "$(date -d "@$LAST_ALERT_TS" '+%F %T')" \
                "$(date -d "@$dueTs" '+%F %T')"
        }

        report "login/backend" "$stateFile"
        report "privileges" "${stateFile%.state}.critical.state"
        report "latency (SLOW)" "${stateFile%.state}.slow.state"
        report "keycloak-sync"  "${stateFile%.state}.sync.state"

        [ "$found" -eq 0 ] && echo "no active alerts"
        exit 0
REMOTE_SCRIPT
    )
}

# The bare timer status says little, so also show the schedule and the last check result.
cmdMonitorStatus() {
    # via stdin, because `bash -c <script>` would lose its argument to ssh's argument flattening
    exec ssh "$backendLogin" bash -s < <(unindented <<'REMOTE_SCRIPT'
        systemctl --user status login-monitoring-check.timer --no-pager || true
        echo
        systemctl --user list-timers login-monitoring-check.timer --no-pager || true
        echo "last check:"
        tail -1 var/login-monitoring.log 2>/dev/null || echo "  (no log yet)"
REMOTE_SCRIPT
    )
}

badAction() { # $1=target  $2=action
    if [ -z "$2" ]; then
        echo "ERROR: target '$1' needs an action" >&2
    else
        echo "ERROR: unknown action '$2' for target '$1'" >&2
    fi
    usage >&2
    exit 1
}

target=${1:-}
shift || true
case "$target" in
    ""|-h|-\?|--help) ;; # help works without a target host
    *) requireDeployHost ;;
esac
case "$target" in
    backend)
        action=${1:-}; shift || true
        case "$action" in
            deploy)                                    cmdBackendDeploy "$@" ;;
            upload)                                    cmdBackendUpload "$@" ;;
            log)                                       cmdLog var/backend.log "$@" ;;
            setup)                                     cmdBackendSetup ;;
            provision-api-key)                         cmdProvisioningApiKey "$@" ;;
            sql)                                       cmdBackendSql "$@" ;;
            sql-tunnel)                                cmdBackendSqlTunnel "$@" ;;
            start|stop|restart|status|enable|disable)  lifecycle backend "$action" ;;
            *)                                         badAction backend "$action" ;;
        esac ;;
    login-monitor)
        action=${1:-}; shift || true
        case "$action" in
            deploy)                             cmdMonitorDeploy "$@" ;;
            run)                                cmdMonitorRun ;;
            log)                                cmdLog var/login-monitoring.log "$@" ;;
            status)                             cmdMonitorStatus ;;
            alerts)                             cmdMonitorAlerts ;;
            start|stop|restart|enable|disable)  lifecycle login-monitor "$action" ;;
            *)                                  badAction login-monitor "$action" ;;
        esac ;;
    ssh)          cmdSsh "$@" ;;
    upload)       cmdUpload "$@" ;;
    ''|-h|--help) usage ;;
    *)            echo "ERROR: unknown target '$target'" >&2; usage >&2; exit 1 ;;
esac
