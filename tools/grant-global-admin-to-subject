#!/usr/bin/env bash
# Grants the global-admin role to a subject by exact name, or to all USER subjects
# of a realm-prefix given with a trailing '-'; see --help.

set -o pipefail

case "${1:-}" in
    -h|-\?|--help)
        source tools/lib/unindented.sh
        unindented <<'HELP'
            usage: tools/grant-global-admin-to-subject <subject-name>|<realm-prefix->

            Grants the role rbac.global#global:ADMIN (with assume) via the REST-API.
            Authenticates via an API-key: establish it with `APIKEY <name>` (which exports
            HSADMINNG_API_KEY) before running, or export HSADMINNG_API_KEY directly.

            The argument is either an exact subject-name, or — with a trailing '-' — a
            realm-prefix: then all USER subjects whose name starts with that prefix get
            the grant, e.g. `hostsharing-` for all Hostsharing team accounts.
            Subject names cannot end with '-', thus the two forms cannot collide.

            If a subject already has that grant the API answers 409 Conflict, which is
            reported and treated as success, thus the command can be re-run anytime.

            Environment:
              HSADMINNG_API_BASE_URL  target API, default https://backend.ng.hostsharing.net
HELP
        exit 0 ;;
esac
if [ $# -ne 1 ]; then
    echo "usage: ${0##*/} <subject-name>|<realm-prefix->, see --help" >&2
    exit 1
fi
subjectArg=$1

# explicitly exported values (e.g. via APIKEY <name> or an export in the calling shell)
# win over the personal .environment defaults, which `source .aliases` re-applies
externalApiBaseUrl=${HSADMINNG_API_BASE_URL:-} externalApiKey=${HSADMINNG_API_KEY:-}
source .aliases
[ -n "$externalApiBaseUrl" ] && export HSADMINNG_API_BASE_URL=$externalApiBaseUrl
[ -n "$externalApiKey" ] && export HSADMINNG_API_KEY=$externalApiKey
require HSADMINNG_API_KEY

export HSADMINNG_API_BASE_URL=${HSADMINNG_API_BASE_URL:-'https://backend.ng.hostsharing.net'}

# tools/http builds the Hostsharing-Api-Key header from HSADMINNG_API_KEY, but prefers a JWT
# bearer if one is set, so drop any stray JWT to ensure the API-key is used
unset HSADMINNG_JWT_BEARER

# global:ADMIN is booked as the granting role, thus assume it for the write
assumeGlobalAdmin=(-H 'Hostsharing-Assumed-Roles: rbac.global#global:ADMIN')

globalAdminRoleUuid=$(HTTP GET /api/rbac/roles \
    | jq -r '.[] | select(.roleIdName == "rbac.global#global:ADMIN") | .uuid')
require globalAdminRoleUuid

declare -i granted=0 alreadyGranted=0 failed=0

function grantGlobalAdminTo() { # <subject-name> <subject-uuid>
    local subjectName=$1 subjectUuid=$2
    echo "granting global-admin to '$subjectName' ($subjectUuid) ..." >&2
    local httpExitCode=0 response
    response=$(HTTP POST /api/rbac/grants "${assumeGlobalAdmin[@]}" <<EOF
{
    "assumed": true,
    "grantedRole.uuid": "$globalAdminRoleUuid",
    "granteeSubject.uuid": "$subjectUuid"
}
EOF
    ) || httpExitCode=$?

    if [ $httpExitCode -eq 0 ]; then
        echo "${0##*/}: granted global-admin to '$subjectName'" >&2
        ((++granted))
    elif grep -Eq '"status" *: *409' <<<"$response"; then
        echo "${0##*/}: '$subjectName' already holds global-admin (409 Conflict)" >&2
        ((++alreadyGranted))
    else
        [ -n "$response" ] && printf '%s\n' "$response" >&2
        echo "${0##*/}: FAILED to grant global-admin to '$subjectName' (HTTP POST exited with $httpExitCode)" >&2
        ((++failed))
    fi
}

# the name query-parameter is a prefix filter: for a realm-prefix argument take all
# matching USER subjects, for an exact subject-name argument only the exact match
subjectsJson=$(HTTP GET "/api/rbac/subjects?name=$subjectArg")
if [[ "$subjectArg" == *- ]]; then
    matches=$(jq -r --arg p "$subjectArg" \
        '.[] | select(.type == "USER" and (.name | startswith($p))) | "\(.uuid)\t\(.name)"' <<<"$subjectsJson")
else
    matches=$(jq -r --arg n "$subjectArg" \
        '.[] | select(.name == $n) | "\(.uuid)\t\(.name)"' <<<"$subjectsJson")
fi
if [ -z "$matches" ]; then
    echo "${0##*/}: no subject matches '$subjectArg'" >&2
    exit 1
fi

while IFS=$'\t' read -r subjectUuid subjectName; do
    grantGlobalAdminTo "$subjectName" "$subjectUuid"
done <<<"$matches"

if [[ "$subjectArg" == *- ]]; then
    echo "${0##*/}: $granted granted, $alreadyGranted already granted, $failed failed" >&2
fi
[ $failed -eq 0 ] || exit 1
