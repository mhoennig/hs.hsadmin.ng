#!/usr/bin/env python3
"""Run the inexpensive checks which should pass before a pull request is reviewed."""

import argparse
import re
import subprocess
from fnmatch import fnmatch
from datetime import date
from itertools import chain
import time
import sys
from pathlib import Path


# spelled apart, or this tool's own messages would be findings of the very check they report
MARKER_WORD = "FIX" + "ME"
MAX_PR_DOC_LINES = 200
# a file counts as much as 15 changed lines, so that small touches weigh less than whole classes;
# together with a maximum below 100 the limit is also easier to remember
MAX_SCOPE_SCORE = 99
# A build may run a few days after the release date was set, e.g. after a rebase or a queued CI.
RELEASE_DATE_TOLERANCE_DAYS = 2
# Beyond this, a branch is stale rather than open work, and its conflicts are noise.
CONFLICT_SCAN_DAYS = 30
PR_DOC_BASE_LINES = 50
PR_DOC_LINES_PER_FILE = 3
# a scenario including its Verified-by section takes about 13 to 23 lines; budgeting slightly less
# keeps it from competing with the prose around it, yet makes each further scenario cost a few lines
PR_DOC_LINES_PER_SCENARIO = 12
SCENARIO_HEADING = re.compile(r"^#### Scenario#", re.MULTILINE)
CHANGE_LINES_PER_SCOPE_POINT = 15
CHANGE_LINES_PER_PR_DOC_LINE = 10
MAX_COMMENT_RATIO_PERCENT = 12
# a small change would otherwise have no room at all for the one comment that earns its place
MIN_COMMENT_LINES_ALLOWED = 2
MAX_FILE_SIZE = 142_994
PR_DOC_DIR = Path("doc/PR")
# exempt like the PR document itself, so unburdening it into an RFC/ADR does not raise the score
EXEMPT_DOC_DIRS = {Path("doc/rfc"), Path("doc/adr")}
# a fixed qualifier vocabulary, so it does not grow wild; only added lines are checked,
# thus legacy qualifiers stay until the line holding them is touched anyway
ALLOWED_MARKER_QUALIFIERS = {
    "TODO": {"doc", "feat", "impl", "legacy", "perf", "rbac", "refa", "spec", "test", "tool"},
    MARKER_WORD: {"review"},
}
QUALIFIED_MARKER = re.compile(r"\b(TODO|" + MARKER_WORD + r")\.([A-Za-z0-9_-]+)")
# same rule as in tools/fixmes: in Markdown a backtick span quotes a marker instead of using it
CODE_SPAN = re.compile(r"`[^`]+`")
HUNK_START = re.compile(r"^@@ -\S+ \+(\d+)")
# AGENTS.md wants Lombok `val`; the agent hook only sees Write/Edit, not Java written from a shell
FINAL_VAR = re.compile(r"\bfinal\s+var\b")
RFC_DIR = Path("doc/rfc")
RFC_NUMBER = re.compile(r"RFC#(\d+)")
NON_PR_DOC_NAMES = {"README.md", "TEMPLATE.md", "TEMPLATE-de.md", "TEAMPLATE.md", "IDEAS.md"}
PR_DOC_NAME = re.compile(
    r"^\d{4}-\d{2}-\d{2}-PR#\d+-[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*\.md$"
)
SQL_DUMP_NAME = re.compile(r"^released-prod-schema-.*\.sql$")
CODE_SUFFIXES = (".java", ".kt", ".kts", ".sql", ".sh", ".py", ".yaml", ".yml")
# files whose comments carry what the file itself cannot say — why a setting has its value —
# and vendored files nobody here writes; each pattern matches the path or the bare file name
COMMENT_RATIO_EXEMPT = (
    ".werkator.yml",
    "application*.yml",
    "gradlew",
)
SCRIPT_SUFFIXES = (".sh", ".py")
SHEBANG = "#!"
LIQUIBASE_DIRECTIVE = re.compile(
    r"^--(/|\s*(changeset|liquibase|validCheckSum|precondition|preconditions"
    r"|rollback|property|include|includeAll|comment|ignoreLines)\b)",
    re.IGNORECASE,
)
COMMENT_MARKER = re.compile(r"^(//+|--+|/\*+|\*+/?)")
# markers of the test convention; they name a place, not a reason, and therefore cannot fall
# out of step with the code the way an explaining sentence does
CONVENTION_MARKERS = {"given", "when", "then", "and"}
# instructions to a tool rather than to a reader; matched by prefix, because they carry
# arguments and, in this repository, the occasional typo like `@formatter:ff`
TOOL_PRAGMAS = ("@formatter:", "noinspection", "nopmd", "checkstyle:")
SCOPE_WAIVER_KEY = "max-scope-score"
SCOPE_WAIVER = re.compile(r"pr-quick-check:max-scope-score=(\d+)\s*[:—–-]+\s*(\S.*)")
PR_DOC_LINES_WAIVER_KEY = "max-pr-doc-lines"
PR_DOC_LINES_WAIVER = re.compile(r"pr-quick-check:max-pr-doc-lines=(\d+)\s*[:—–-]+\s*(\S.*)")
RELEASE_NOTE_HEADING = "\n## Release Note\n"
RELEASED_ON = re.compile(r"^released:\s*(\d{4}-\d{2}-\d{2})\s*$", re.MULTILINE)
EXTRA_PR_DOCS_KEY = "extra-pr-docs"
EXTRA_PR_DOCS = re.compile(r"pr-quick-check:extra-pr-docs=(\d+)\s*[:—–-]+\s*(\S.*)")
# no <> in the ref, so that a document explaining the syntax does not declare `<ref>` as its base
DECLARED_BASE = re.compile(r"pr-quick-check:base=([^\s`<>]+)")
ALLOWED_ENV_FILE_NAMES = {
    ".env.example",
    ".env.local",
    ".env.template",
    ".environment.example",
    ".environment.local",
    ".environment.template",
    ".envrc",
}
PR_DOC_SECTIONS = [
    (("Related Links", "Verwandte Links"), False),
    (("The Problem", "Das Problem"), True),
    (("Non-Goals", "Nicht-Ziele"), True),
    (("The Scenarios", "Die Szenarien"), False),
    (("The Solution", "Die Lösung"), True),
    (("Open Questions", "Offene Fragen", "Offene Punkte"), False),
    (("Additional Changes", "Zusätzliche Änderungen"), False),
    (("Prerequisite PRs", "Voraussetzungs-PRs"), False),
    (("Follow-up PRs", "Folge-PRs"), False),
    (("Attachments", "Anhänge"), False),
]


def git(*args):
    result = subprocess.run(
        ["git", *args], text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE
    )
    if result.returncode:
        message = result.stderr.strip() or "git command failed"
        raise RuntimeError(message)
    return result.stdout


def default_base():
    origin_head = subprocess.run(
        ["git", "symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD"],
        text=True,
        stdout=subprocess.PIPE,
    )
    if origin_head.returncode == 0:
        return origin_head.stdout.strip()
    for candidate in ("origin/master", "master", "origin/main", "main"):
        if subprocess.run(
            ["git", "rev-parse", "--verify", "--quiet", candidate],
            stdout=subprocess.DEVNULL,
        ).returncode == 0:
            return candidate
    raise RuntimeError("cannot determine a default base branch, pass it explicitly")


def try_ref_commit(ref):
    result = subprocess.run(
        ["git", "rev-parse", "--verify", "--quiet", ref],
        text=True,
        stdout=subprocess.PIPE,
    )
    return result.stdout.strip() if result.returncode == 0 else None


def ensure_base_refs_match(base):
    """Both refs of a base branch must agree, so the diff is taken against the true target;
    for a SHA/tag base or a checkout lacking one of the refs there is nothing to compare."""
    name = base.removeprefix("origin/")
    local = try_ref_commit(f"refs/heads/{name}")
    remote = try_ref_commit(f"refs/remotes/origin/{name}")
    if local and remote and local != remote:
        raise RuntimeError(
            f"local {name} differs from origin/{name}; update the remote-tracking ref and "
            f"local branch first, for example with: git fetch origin {name}:{name}"
        )


def authoritative_base_ref(base):
    name = base.removeprefix("origin/")
    if try_ref_commit(f"refs/remotes/origin/{name}"):
        return f"origin/{name}"
    return base


def ensure_branch_contains_base(base):
    ref = authoritative_base_ref(base)
    result = subprocess.run(
        ["git", "merge-base", "--is-ancestor", ref, "HEAD"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if result.returncode:
        raise RuntimeError(
            f"the current branch does not contain {ref}; rebase it with: git rebase {ref}"
        )


def changed_files(base, untracked):
    merge_base = git("merge-base", "HEAD", base).strip()
    paths = set(git("diff", "--name-only", "-z", merge_base).split("\0"))
    paths.update(untracked)
    paths.discard("")
    return merge_base, sorted(paths)


def untracked_files():
    return sorted(
        path
        for path in git("ls-files", "--others", "--exclude-standard", "-z").split("\0")
        if path
    )


def is_secret_env_path(path):
    name = Path(path).name
    return name.startswith(".env") and name not in ALLOWED_ENV_FILE_NAMES


def tracked_secret_env_files(paths):
    tracked = set(git("ls-files", "-z").split("\0"))
    return [
        path
        for path in paths
        if path in tracked and is_secret_env_path(path)
    ]


def pr_doc_candidates(paths):
    return [
        Path(path)
        for path in paths
        if Path(path).parent == PR_DOC_DIR
        and Path(path).suffix == ".md"
        and Path(path).name not in NON_PR_DOC_NAMES
    ]


def effective_lines(pr_doc):
    """A tag in backticks documents a declaration, only one outside of them declares it."""
    return [CODE_SPAN.sub("", line) for line in pr_doc.read_text(encoding="utf-8").splitlines()]


def declared_in(pr_doc, pattern):
    return next((match for line in effective_lines(pr_doc) if (match := pattern.search(line))), None)


def declared_base(paths):
    """The target branch of a PR which builds on another one instead of the default base;
    in a deeper stack the prerequisite documents in the diff also carry their declarations,
    but only this PR's own document is absent from every declared base ref."""
    declaring = [
        (path, match.group(1))
        for path in pr_doc_candidates(paths)
        if path.is_file() and (match := declared_in(path, DECLARED_BASE))
    ]
    own = [
        (path, ref)
        for path, ref in declaring
        if not any(
            other_path != path
            and try_ref_commit(f"{authoritative_base_ref(other_ref)}:{path}")
            for other_path, other_ref in declaring
        )
    ]
    if len(own) > 1:
        names = ", ".join(str(path) for path, _ in own)
        raise RuntimeError(
            f"{len(own)} changed PR documents declare a base: {names}; "
            "only this PR's own document may declare it"
        )
    return own[0][1] if own else None


def declared_base_applies(declared, base):
    """A declared base counts only until it is merged: afterwards the default base contains it
    and gives the same diff, so the declaration may stay in the document once it is history."""
    ref = authoritative_base_ref(declared)
    if not try_ref_commit(ref):
        return False
    return subprocess.run(
        ["git", "merge-base", "--is-ancestor", ref, base],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ).returncode != 0


def find_pr_doc(paths, explicit_pr_doc):
    if explicit_pr_doc:
        path = Path(explicit_pr_doc)
        if not path.is_file():
            raise RuntimeError(f"PR document does not exist: {path}")
        return path

    candidates = pr_doc_candidates(paths)
    if len(candidates) == 1:
        return candidates[0]

    # With several changed PR documents, the one carrying the exception is this PR's own;
    # the others are the ones it declares.
    declaring = [path for path in candidates if declared_in(path, EXTRA_PR_DOCS)]
    if len(declaring) == 1:
        return declaring[0]
    if len(declaring) > 1:
        names = ", ".join(str(path) for path in declaring)
        raise RuntimeError(
            f"{len(declaring)} changed PR documents declare a further-PR-documents "
            f"exception: {names}; only this PR's own document may declare it"
        )

    names = ", ".join(str(path) for path in candidates) or "none"
    raise RuntimeError(
        f"expected exactly one changed PR document, found {len(candidates)}: {names}; "
        "for a PR built on another one name its target branch in this PR's own document with "
        "pr-quick-check:base=<ref> outside of backticks, otherwise select the document with --pr-doc, "
        "or declare the exception in it with pr-quick-check:extra-pr-docs=<count>: <reason>"
    )


def logical_file_count(paths):
    regular = 0
    rbac_sql = False
    rbac_md = False
    for path in paths:
        if path.endswith("-rbac.sql"):
            rbac_sql = True
        elif path.endswith("-rbac.md"):
            rbac_md = True
        else:
            regular += 1
    return regular + int(rbac_sql) + int(rbac_md)


def is_substantive(path, pr_doc):
    candidate = Path(path)
    if candidate == pr_doc or candidate.parent in EXEMPT_DOC_DIRS:
        return False
    if path.endswith(("-rbac.sql", "-rbac.md")):
        return False
    return not (
        candidate.parent == Path("src/test/resources/db")
        and SQL_DUMP_NAME.fullmatch(candidate.name)
    )


def tracked_change_lines(merge_base, pr_doc):
    fields = git("diff", "--numstat", "-z", merge_base).split("\0")
    change_lines = 0
    index = 0
    while index < len(fields):
        field = fields[index]
        index += 1
        if not field:
            continue
        added, deleted, path = field.split("\t", 2)
        if not path:
            index += 1  # old path of a rename
            path = fields[index]  # new path of a rename
            index += 1
        if is_substantive(path, pr_doc) and added != "-" and deleted != "-":
            change_lines += int(added) + int(deleted)
    return change_lines


def untracked_change_lines(paths, pr_doc):
    change_lines = 0
    for path_string in paths:
        if not is_substantive(path_string, pr_doc):
            continue
        raw = Path(path_string).read_bytes()
        if b"\0" not in raw:
            change_lines += len(raw.splitlines())
    return change_lines


def validate_pr_doc(pr_doc):
    failures = []
    if not PR_DOC_NAME.fullmatch(pr_doc.name):
        failures.append(
            f"PR document name does not match YYYY-MM-DD-PR#<number>-<description>.md: {pr_doc}"
        )

    headings = [
        line.removeprefix("## ").strip()
        for line in pr_doc.read_text(encoding="utf-8").splitlines()
        if line.startswith("## ")
    ]
    positions = []
    for names, required in PR_DOC_SECTIONS:
        matches = [index for index, heading in enumerate(headings) if heading in names]
        if required and not matches:
            failures.append(f"{pr_doc} lacks required section '{names[0]}'")
        if matches:
            positions.append((matches[0], names[0]))
    for previous, current in zip(positions, positions[1:]):
        if previous[0] >= current[0]:
            failures.append(
                f"{pr_doc} section '{current[1]}' appears before '{previous[1]}'"
            )
    return failures


def parse_declared_maximum(pr_doc, key, pattern, what, syntax):
    """A PR may declare a budget exception in its PR document; the declared number
    becomes this PR's approved ceiling and may leave room for further changes."""
    declarations = []
    failures = []
    for line in effective_lines(pr_doc):
        if f"pr-quick-check:{key}" not in line:
            continue
        match = pattern.search(line)
        if match:
            declarations.append((int(match.group(1)), match.group(2).strip()))
        else:
            failures.append(
                f"{pr_doc} contains a malformed {what} exception; expected "
                f"{syntax} outside of backticks — fill in a number, "
                "or quote the line in backticks if it only documents the declaration"
            )
    if len(declarations) > 1:
        failures.append(f"{pr_doc} declares more than one {what} exception")
    return (declarations[0] if len(declarations) == 1 else None), failures


def parse_scope_waiver(pr_doc):
    return parse_declared_maximum(
        pr_doc,
        SCOPE_WAIVER_KEY,
        SCOPE_WAIVER,
        "scope-budget",
        "pr-quick-check:max-scope-score=<score>: <reason>",
    )


def parse_pr_doc_lines_waiver(pr_doc):
    return parse_declared_maximum(
        pr_doc,
        PR_DOC_LINES_WAIVER_KEY,
        PR_DOC_LINES_WAIVER,
        "PR-document-lines",
        "pr-quick-check:max-pr-doc-lines=<lines>: <reason>",
    )


def check_verified_by_sections(pr_doc):
    """The Verified-by links come from the scenario test run, thus they can be verified instead of
    being proof-read; without an index there is nothing to compare against."""
    result = subprocess.run(
        ["tools/generate-verified-by", str(pr_doc), "--check"],
        capture_output=True,
        text=True,
    )
    reported = [line for line in result.stdout.splitlines() if line.startswith("FAILED: ")]
    if reported:
        return [line.removeprefix("FAILED: ") for line in reported]
    if result.returncode != 0:
        return [f"tools/generate-verified-by failed: {result.stderr.strip() or result.stdout.strip()}"]
    print(result.stdout.strip())
    return []


def check_release_note_date(pr_doc):
    """A PR document is started long before the PR is merged, thus its file name is no reliable
    release date; the note names the day it goes live and has to be about current at build time."""
    text = pr_doc.read_text(encoding="utf-8")
    if RELEASE_NOTE_HEADING not in text:
        return []
    appendix = text.split(RELEASE_NOTE_HEADING, 1)[1]
    match = RELEASED_ON.search(appendix)
    if not match:
        return [
            f"{pr_doc} has a release note without a release date; add a line "
            "`released: <YYYY-MM-DD>` right below its heading"
        ]
    today = date.today()
    released = date.fromisoformat(match.group(1))
    if abs((released - today).days) > RELEASE_DATE_TOLERANCE_DAYS:
        return [
            f"{pr_doc} declares the release note as released on {released}, but today is "
            f"{today}; a merged note keeps this date, thus set it to the day of the merge, "
            f"at most {RELEASE_DATE_TOLERANCE_DAYS} days apart"
        ]
    print(f"PASSED: the release note is dated {released}, at most {RELEASE_DATE_TOLERANCE_DAYS} days from today")
    return []


def added_diff_lines(merge_base):
    """(path, line number, text) of every line the diff adds."""
    path = None
    line_number = 0
    for line in git("diff", "--unified=0", merge_base).splitlines():
        if line.startswith("+++ b/"):
            path = line.removeprefix("+++ b/")
        elif line.startswith("+++"):
            path = None
        elif match := HUNK_START.match(line):
            line_number = int(match.group(1))
        elif path and line.startswith("+"):
            yield path, line_number, line[1:]
            line_number += 1


def untracked_lines(paths):
    for path_string in paths:
        raw = Path(path_string).read_bytes()
        if b"\0" in raw:
            continue
        text = raw.decode("utf-8", errors="replace")
        for line_number, line in enumerate(text.splitlines(), start=1):
            yield path_string, line_number, line


def report_undefined_qualifiers(merge_base, untracked):
    findings = []
    for path, line_number, text in chain(added_diff_lines(merge_base), untracked_lines(untracked)):
        code_spans = [match.span() for match in CODE_SPAN.finditer(text)] if path.endswith(".md") else []
        for match in QUALIFIED_MARKER.finditer(text):
            if any(start <= match.start() < end for start, end in code_spans):
                continue
            if match.group(2) not in ALLOWED_MARKER_QUALIFIERS[match.group(1)]:
                findings.append(f"  {path}:{line_number}: {match.group(0)}")
    if findings:
        defined = ", ".join(
            f"{marker}.{{{','.join(sorted(qualifiers))}}}"
            for marker, qualifiers in ALLOWED_MARKER_QUALIFIERS.items()
        )
        listed = "\n".join(findings)
        return [
            f"added lines use undefined TODO/{MARKER_WORD} qualifiers:\n{listed}\n"
            f"  defined are: {defined}"
        ]
    print(f"PASSED: added lines only use defined TODO/{MARKER_WORD} qualifiers")
    return []


def report_final_var(merge_base, untracked):
    findings = [
        f"  {path}:{line_number}: {text.strip()}"
        for path, line_number, text in chain(added_diff_lines(merge_base), untracked_lines(untracked))
        if path.endswith(".java") and FINAL_VAR.search(text)
    ]
    if findings:
        listed = "\n".join(findings)
        return [f"added Java lines use 'final var', use Lombok 'val' instead:\n{listed}"]
    print("PASSED: added Java lines use Lombok 'val' instead of 'final var'")
    return []


def may_hold_code(path):
    """Whether the file is worth reading for the ratio; an extension-less one may be a script."""
    return path.endswith(CODE_SUFFIXES) or "." not in Path(path).name


def comment_ratio_exempt(path):
    """A bare name in the list exempts that file wherever it lies, a pattern with a slash
    only at its place."""
    return any(
        fnmatch(path, pattern) or fnmatch(Path(path).name, pattern)
        for pattern in COMMENT_RATIO_EXEMPT
    )


def comment_syntax(path, text):
    """The line-comment token and whether the language has /* */ blocks, or None for a file
    the ratio does not cover. An extension-less script is recognized by its shebang."""
    if path.endswith((".java", ".kt", ".kts")):
        return "//", True
    if path.endswith(".sql"):
        return "--", True
    if path.endswith((*SCRIPT_SUFFIXES, ".yaml", ".yml")) or text.startswith(SHEBANG):
        return "#", False
    return None


def is_script(path, text):
    """Only a script gets its header block exempted, because only there does AGENTS.md turn that
    block into the --help output; in a configuration file it would just be a place to hide prose."""
    return path.endswith(SCRIPT_SUFFIXES) or text.startswith(SHEBANG)


def documented_header(lines):
    """How many leading lines are the shebang and the header comment block, which AGENTS.md
    makes the source of a tool's --help output and thus its documentation, not its commentary."""
    end = 0
    for index, line in enumerate(lines):
        stripped = line.strip()
        if index == 0 and stripped.startswith(SHEBANG):
            end = 1
        elif not stripped or stripped.startswith("#"):
            end = index + 1
        else:
            break
    return end


def comment_parts(text, line_comment, blocks):
    """Per line, its code outside any comment and its comment content.
    `/* … */` spans a region whose inner lines carry no marker of their own, so the lines cannot
    be classified one by one; string literals are skipped, or a `"http://…"` would open one."""
    depth = 0
    quote = None
    for line in text.splitlines():
        code = []
        comment = []
        index = 0
        while index < len(line):
            rest = line[index:]
            if depth:
                if rest.startswith("*/"):
                    depth -= 1
                    index += 2
                elif rest.startswith("/*"):
                    depth += 1
                    index += 2
                else:
                    comment.append(line[index])
                    index += 1
            elif quote:
                code.append(line[index])
                if rest.startswith("\\"):
                    index += 2
                elif rest.startswith(quote):
                    index += len(quote)
                    quote = None
                else:
                    index += 1
            elif rest.startswith(line_comment):
                comment.append(rest[len(line_comment):])
                break
            elif blocks and rest.startswith("/*"):
                depth = 1
                index += 2
            elif rest.startswith('"""'):
                code.append(rest[:3])
                quote = '"""'
                index += 3
            elif line[index] in "\"'":
                code.append(line[index])
                quote = line[index]
                index += 1
            else:
                code.append(line[index])
                index += 1
        # a plain string literal cannot span lines; only a text block may
        if quote and quote != '"""':
            quote = None
        yield "".join(code), "".join(comment)


def is_comment_line(path, raw, code, comment):
    """Whether the line is explaining prose, which is what can fall out of step with its code.
    Liquibase directives, rulers, bare block-comment delimiters and convention markers cannot,
    and a comment trailing a statement costs nothing, so all of them count as code."""
    if code.strip():
        return False
    if path.endswith(".sql") and LIQUIBASE_DIRECTIVE.match(raw.strip()):
        return False
    prose = COMMENT_MARKER.sub("", comment.strip(), count=1).strip().lower()
    if not any(character.isalpha() for character in prose):
        return False
    return prose not in CONVENTION_MARKERS and not prose.startswith(TOOL_PRAGMAS)


def report_comment_ratio(merge_base, untracked):
    """A comment which restates its code rots as soon as the code moves on, so a PR whose added
    code is mostly prose is a review finding of its own. Only whole comment lines count; a short
    trailing comment behind a statement costs nothing."""
    added = {}
    for path, line_number, _ in added_diff_lines(merge_base):
        if may_hold_code(path):
            added.setdefault(path, set()).add(line_number)
    for path in untracked:
        if may_hold_code(path):
            added[path] = None  # a new file contributes all of its lines

    code_lines = 0
    comment_lines = 0
    per_file = {}
    exempted = []
    for path, line_numbers in sorted(added.items()):
        if comment_ratio_exempt(path):
            exempted.append(path)
            continue
        raw_bytes = Path(path).read_bytes() if Path(path).is_file() else b"\0"
        if b"\0" in raw_bytes:
            continue
        text = raw_bytes.decode("utf-8", errors="replace")
        syntax = comment_syntax(path, text)
        if not syntax:
            continue
        lines = text.splitlines()
        header_end = documented_header(lines) if is_script(path, text) else 0
        parts = comment_parts(text, *syntax)
        for number, (raw, (code, comment)) in enumerate(zip(lines, parts), start=1):
            if (line_numbers is not None and number not in line_numbers) or not raw.strip():
                continue
            if number <= header_end:
                continue
            code_lines += 1
            if is_comment_line(path, raw, code, comment):
                comment_lines += 1
                per_file[path] = per_file.get(path, 0) + 1
    shown = ", ".join(exempted[:3])
    skipped = (
        f", exempt: {shown}{f' and {len(exempted) - 3} more' if len(exempted) > 3 else ''}"
        if exempted
        else ""
    )
    if not code_lines:
        print(f"PASSED: no added code lines to measure a comment ratio on{skipped}")
        return []
    allowed = max(
        MIN_COMMENT_LINES_ALLOWED, code_lines * MAX_COMMENT_RATIO_PERCENT // 100
    )
    ratio = 100 * comment_lines / code_lines
    if comment_lines <= allowed:
        print(
            f"PASSED: {comment_lines} of {code_lines} added code lines are comments "
            f"({ratio:.1f}%), at most {allowed} allowed{skipped}"
        )
        return []
    listed = "\n".join(
        f"  {path}: {count} comment lines"
        for path, count in sorted(per_file.items(), key=lambda item: -item[1])[:5]
    )
    return [
        f"{comment_lines} of {code_lines} added code lines are comments ({ratio:.1f}%), "
        f"at most {allowed} allowed ({MAX_COMMENT_RATIO_PERCENT}% or "
        f"{MIN_COMMENT_LINES_ALLOWED} lines, whichever is more){skipped}; a comment has to "
        f"give a reason, not restate the code:\n{listed}"
    ]


def report_open_fixmes():
    """Quotes the markers into the failure message, because tools/fixmes writes them straight
    to the terminal, whereas the failures are collected and printed screens further down."""
    result = subprocess.run(["tools/fixmes"], text=True, stdout=subprocess.PIPE)
    if result.returncode == 0:
        print(f"PASSED: no open {MARKER_WORD}s")
        return []
    listed = result.stdout.rstrip("\n").splitlines()
    count = sum(1 for line in listed if line and not line.startswith(" "))
    quoted = "\n".join(f"  {line}" for line in listed)
    return [
        f"{count} open {MARKER_WORD}{'' if count == 1 else 's'}:\n{quoted}\n"
        f"  resolve {'it' if count == 1 else 'them'}; a mere mention belongs in backticks "
        "(Markdown), an intentional open one inside "
        "<!-- disable:fixme --> … <!-- enable:fixme -->"
    ]


def current_branch():
    return subprocess.run(
        ["git", "branch", "--show-current"], text=True, stdout=subprocess.PIPE,
    ).stdout.strip()


def conflicting_paths(ours, theirs):
    """Merges in memory, without touching the working tree; a non-zero exit means conflicts."""
    result = subprocess.run(
        ["git", "merge-tree", "--write-tree", "--name-only", "--no-messages", ours, theirs],
        text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    )
    if result.returncode == 0:
        return []
    return [line for line in result.stdout.splitlines()[1:] if line.strip()]


def open_origin_branches(base):
    """Only branches with open work: not yet contained in the base, and touched recently.
    A long-abandoned branch conflicts with almost anything, which would be noise."""
    listed = subprocess.run(
        ["git", "for-each-ref", "--format=%(refname:short) %(committerdate:unix)",
         "refs/remotes/origin"],
        text=True, stdout=subprocess.PIPE,
    ).stdout.splitlines()
    cutoff = time.time() - CONFLICT_SCAN_DAYS * 86400
    current = current_branch()
    branches = []
    for line in listed:
        name, _, timestamp = line.rpartition(" ")
        if not name or name.endswith("/HEAD") or name == base or name == f"origin/{current}":
            continue
        if float(timestamp) < cutoff:
            continue
        contained = subprocess.run(
            ["git", "merge-base", "--is-ancestor", name, base],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        if contained.returncode != 0:
            branches.append(name)
    return sorted(branches)


def report_conflicts(base, open_branches, own_paths):
    """A conflict with the target branch blocks the merge; one with another open branch only
    announces the work which whoever merges second will have to do.

    Cross-branch conflicts only count in files this branch changes itself: in any other file
    they stem from the other branch lagging behind the base, so they are that branch's news
    and show up when it runs this check.

    The check against the base can only fail if it ever runs before ensure_branch_contains_base,
    which already demands that the base is merged in — and then merging it again cannot conflict."""
    failures = []
    against_base = conflicting_paths("HEAD", base)
    if against_base:
        failures.append(
            f"merging {base} conflicts in: {', '.join(against_base)}; merge or rebase it first"
        )
    else:
        print(f"PASSED: no merge conflict with {base}")

    own = set(own_paths)
    conflicting = [
        (branch, paths)
        for branch in open_branches
        if (paths := sorted(own.intersection(conflicting_paths("HEAD", branch))))
    ]
    for branch, paths in conflicting:
        shown = ", ".join(paths[:4]) + (", ..." if len(paths) > 4 else "")
        print(f"WARNING: conflicts with {branch} in: {shown}", file=sys.stderr)
    if not conflicting:
        print(f"PASSED: no conflict with a branch on origin touched within "
              f"{CONFLICT_SCAN_DAYS} days")
    return failures


def rfc_numbers_at(ref):
    """RFC number -> document names under doc/rfc at that ref."""
    listing = subprocess.run(
        ["git", "ls-tree", "-r", "--name-only", ref, "--", str(RFC_DIR)],
        text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
    ).stdout.splitlines()
    return rfc_numbers_of(Path(path).name for path in listing)


def rfc_numbers_of(names):
    numbers = {}
    for name in names:
        if match := RFC_NUMBER.search(name):
            numbers.setdefault(int(match.group(1)), set()).add(name)
    return numbers


def report_duplicate_rfc_numbers(merge_base, open_branches):
    """An RFC number names exactly one document. The working tree counts, not HEAD, because a
    new RFC starts out untracked; a clash with an open origin branch only warns, like a merge
    conflict, because whoever merges second has to renumber either way. Documents already at
    the merge base are settled and claim nothing — otherwise every branch would be blamed for
    a clash between the base and some other branch."""
    ours = rfc_numbers_of(
        path.name for path in RFC_DIR.iterdir() if path.is_file()
    ) if RFC_DIR.is_dir() else {}

    failures = [
        f"RFC number {number} is used by {len(names)} documents: {', '.join(sorted(names))}"
        for number, names in sorted(ours.items())
        if len(names) > 1
    ]

    settled = rfc_numbers_at(merge_base)
    claimed = {
        number: fresh
        for number, names in ours.items()
        if (fresh := names - settled.get(number, set()))
    }
    clashing = [
        (branch, number, sorted(other))
        for branch in open_branches
        for number, names in sorted(rfc_numbers_at(branch).items())
        if number in claimed
        and (other := names - settled.get(number, set()) - claimed[number])
    ]
    for branch, number, names in clashing:
        print(
            f"WARNING: RFC number {number} is also claimed on {branch} by: {', '.join(names)}",
            file=sys.stderr,
        )
    if not failures:
        print("PASSED: every RFC number names exactly one document on this branch")
    return failures


def parse_extra_pr_docs(pr_doc):
    """A PR which has to change further PR documents declares how many, so that the
    exception and its reason are as visible to the reviewer as the change itself."""
    declarations = []
    failures = []
    for line in effective_lines(pr_doc):
        if f"pr-quick-check:{EXTRA_PR_DOCS_KEY}" not in line:
            continue
        match = EXTRA_PR_DOCS.search(line)
        if match:
            declarations.append((int(match.group(1)), match.group(2).strip()))
        else:
            failures.append(
                f"{pr_doc} contains a malformed further-PR-documents exception; expected "
                "pr-quick-check:extra-pr-docs=<count>: <reason> outside of backticks — fill in a "
                "numeric count, or quote the line in backticks if it only documents the declaration"
            )
    if len(declarations) > 1:
        failures.append(f"{pr_doc} declares more than one further-PR-documents exception")
    return (declarations[0] if len(declarations) == 1 else None), failures


def oversized_files(paths):
    oversized = []
    for path_string in paths:
        path = Path(path_string)
        if not path.is_file():
            continue
        if path.parent == Path(
            "src/test/resources/db"
        ) and SQL_DUMP_NAME.fullmatch(path.name):
            continue
        size = path.stat().st_size
        if size > MAX_FILE_SIZE:
            oversized.append((path, size))
    return oversized


def parse_args():
    parser = argparse.ArgumentParser(
        prog="tools/pr-quick-check",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Run the inexpensive local quality gate before requesting a PR review.",
        epilog=f"""
checks:
  - if the base branch exists both locally and on origin, both point to the
    same commit
  - the current branch contains the base, preferring its origin ref
  - without any changes against the base, as on the base branch itself,
    the check passes trivially
  - git diff --check succeeds
  - exactly one changed PR document follows the filename and section conventions
  - the PR document stays within its dynamic line budget, or its declared maximum
  - tools/fixmes reports no open {MARKER_WORD} markers
  - added lines only use the defined TODO/{MARKER_WORD} qualifiers
  - added Java lines use Lombok 'val' instead of 'final var'
  - at most 12% of the added code lines are whole comment lines
  - every RFC number under doc/rfc/ names exactly one document; the same
    number claimed differently on an open origin branch only warns
  - no secret environment files named .env* are tracked; .envrc and exact
    .env/.environment example, local and template filenames are exempt
  - the change stays within its dynamic scope budget
  - changed non-dump files have at most 142994 bytes
  - no generated files below build/ are tracked
  - all non-ignored, untracked files are explicitly allowed

size budgets:
  scope score = logical files + ceil(substantive changed lines / 15)
  maximum scope score = 99

  PR-document lines =
      {PR_DOC_LINES_PER_SCENARIO} * scenarios + min(200, 50 + 3 * logical files + ceil(substantive changed lines / 10))

  Scenarios are counted by their `#### Scenario#` headings.  Documentation grows with the
  number of requirements a PR settles, not only with the code it changes, thus each scenario
  brings its own budget.  It covers a short scenario; each longer one costs a few lines of
  the general budget, which limits the number of scenarios in one PR.

  All changed *-rbac.sql files count as one logical file, and all changed
  *-rbac.md files count as one.  The selected PR document, documents under
  doc/rfc/ and doc/adr/, generated RBAC files and released-prod-schema-*.sql
  dumps do not contribute substantive changed lines.

comment ratio:
  Of the lines a PR adds to code, at most 12% may be whole comment lines, but always at
  least two of them, so that a small change keeps room for the one comment which earns
  its place.  Code means .java, .kt, .kts, .sql, .sh, .py, .yaml and .yml plus the
  extension-less tools, recognized by their shebang; YAML counts because configuration
  is code rather than prose.  A script's shebang and the header comment block below it
  do not count, being the source of its --help output, but a configuration file has no
  such exemption.  There is deliberately no exception to declare in a PR document: the
  mostly redundant comments are the very thing to prevent.  A fixed list of files is
  exempt instead, named in COMMENT_RATIO_EXEMPT at the top of this tool: configuration
  whose comments hold the reasons a key cannot state itself, such as .werkator.yml and
  application*.yml, and vendored files such as gradlew.  Whatever it skipped, it names.

  Since /* ... */ spans a region, the whole file is read and block comments and string
  literals are tracked across lines.  Blank lines count for neither side, and a trailing
  comment behind a statement is free.
  Rulers without letters, bare block-comment delimiters, the // given, // when and
  // then markers, tool pragmas such as // @formatter:off or //noinspection, and
  Liquibase directives such as --changeset are code, not comments.
  The two-line floor makes the rule continuous: 12% of 20 lines is two lines as well.

declarations:
  A PR document declares an exception or its base with a tag of the form pr-quick-check:<key>=<value>
  outside of backticks.  In backticks the same tag only documents it, as for the markers above,
  thus a PR document which changes these rules can quote any tag without declaring it.

scope-budget exception:
  When a PR legitimately has to exceed the scope budget, its PR document
  declares the exception, preferably in the Non-Goals section:

      pr-quick-check:max-scope-score=<score>: <reason>

  The declared score becomes this PR's approved ceiling.
  It's purpose is to intentionally exceed the current score for specific PRs,
  for example for large automatic refactorings or mass-data generators.
  Having this in the PR-doc also makes the decision and reason obvious to the reviewer of the PR.
  An exception whose score is not needed (actual score within the default maximum) fails the check
  and must be removed.

PR-document-lines exception:
  The line budget grows with the code a PR changes, but the documentation a PR needs grows with
  the number of requirements and decisions it settles.  A small but dense change can therefore
  legitimately need a longer document, and declares that the same way:

      pr-quick-check:max-pr-doc-lines=<lines>: <reason>

  The declared number replaces the dynamic maximum, and an exception which is not needed fails
  the check and must be removed.

base branch of a stacked PR:
  Only the pull-request platform knows that a PR targets another PR's branch instead of
  the default base, so its own PR document names the target, preferably in the
  Prerequisite-PRs section:

      pr-quick-check:base=<ref>

  It counts until the named ref is merged into the default base or disappears; from then
  on the default base gives the same diff and the declaration may stay as history.
  In a deeper stack the prerequisite documents keep their own declarations: a document
  already contained in another declared base belongs to a prerequisite, not to this PR.
  An explicitly passed base wins over the declaration.

merge conflicts:
  A conflict with the base fails the check; a conflict with another branch on origin only
  warns, because whoever merges second has to resolve it either way.  Only branches which
  the base does not contain yet and which were touched within the last 30 days are compared:
  an abandoned branch conflicts with almost anything, which would drown the signal.
  Cross-branch conflicts are also limited to files this branch changes itself; conflicts
  the other branch has with the base in unrelated files are reported there, not here.

further-PR-documents exception:
  A PR normally changes exactly one PR document.  When it legitimately has to change
  more, for example to back-fill release notes into merged PRs, its own PR document
  declares how many further ones it changes:

      pr-quick-check:extra-pr-docs=<count>: <reason>

  The declaring document is taken as this PR's own.  The count has to match, and an
  exception which is not needed fails the check and must be removed.

examples:
  tools/pr-quick-check
  tools/pr-quick-check master --pr-doc doc/PR/2026-08-03-PR#264-example.md
  tools/pr-quick-check --allow-untracked tools/new-tool
""",
    )
    parser.add_argument(
        "base",
        nargs="?",
        help="target branch or revision (default: origin/master, then master)",
    )
    parser.add_argument(
        "--pr-doc",
        metavar="PATH",
        help="PR document to check when the diff contains zero or multiple PR documents",
    )
    parser.add_argument(
        "--allow-untracked",
        action="append",
        default=[],
        metavar="PATH",
        help="declare an untracked file as intentional; may be repeated",
    )
    return parser.parse_args()


def main():
    args = parse_args()
    failures = []
    try:
        base = args.base or default_base()
        ensure_base_refs_match(base)
        ensure_branch_contains_base(base)
        untracked = untracked_files()
        unexpected_untracked = sorted(set(untracked) - set(args.allow_untracked))
        merge_base, paths = changed_files(base, untracked)
        if not paths:
            # base branches like master or a future prod have no PR content to check
            print(f"PASSED: no changes against {base}; nothing to quick-check")
            return 0
        # the declaration lives in a PR document, which is why the diff has to be taken once
        # against the default base before the real one is known
        declared = None if args.base else declared_base(paths)
        if declared and declared_base_applies(declared, base):
            print(f"using the base {declared} declared in the PR document")
            # resolved like the default base, so a checkout without the local branch works too
            base = authoritative_base_ref(declared)
            ensure_base_refs_match(base)
            ensure_branch_contains_base(base)
            merge_base, paths = changed_files(base, untracked)
        pr_doc = find_pr_doc(paths, args.pr_doc)
    except RuntimeError as error:
        print(f"FAILED: {error}", file=sys.stderr)
        return 1

    secret_env_files = tracked_secret_env_files(paths)
    if secret_env_files:
        print(
            "CRITICAL: possible secret environment files are tracked: "
            + ", ".join(secret_env_files),
            file=sys.stderr,
        )
        print(
            "Remove them from Git immediately and rotate every secret they contained.",
            file=sys.stderr,
        )
        return 1

    if unexpected_untracked:
        failures.append(
            "untracked files must be added or explicitly allowed with --allow-untracked: "
            + ", ".join(unexpected_untracked)
        )

    diff_check = subprocess.run(["git", "diff", "--check", merge_base])
    if diff_check.returncode:
        failures.append("git diff --check reports whitespace errors or conflict markers")
    else:
        print("PASSED: git diff --check")

    file_count = logical_file_count(paths)
    change_lines = tracked_change_lines(merge_base, pr_doc) + untracked_change_lines(
        untracked, pr_doc
    )
    scope_score = file_count + (
        change_lines + CHANGE_LINES_PER_SCOPE_POINT - 1
    ) // CHANGE_LINES_PER_SCOPE_POINT
    scenarios = len(SCENARIO_HEADING.findall(pr_doc.read_text(encoding="utf-8")))
    scenario_lines = PR_DOC_LINES_PER_SCENARIO * scenarios
    pr_doc_limit = scenario_lines + min(
        MAX_PR_DOC_LINES,
        PR_DOC_BASE_LINES
        + PR_DOC_LINES_PER_FILE * file_count
        + (change_lines + CHANGE_LINES_PER_PR_DOC_LINE - 1)
        // CHANGE_LINES_PER_PR_DOC_LINE,
    )

    line_count = len(pr_doc.read_bytes().splitlines())
    pr_doc_waiver, pr_doc_waiver_failures = parse_pr_doc_lines_waiver(pr_doc)
    failures.extend(pr_doc_waiver_failures)
    if pr_doc_waiver and line_count <= pr_doc_limit:
        failures.append(
            f"{pr_doc} declares a PR-document-lines exception, but its {line_count} lines are "
            f"within the dynamic maximum {pr_doc_limit}; remove it"
        )
    if pr_doc_waiver:
        pr_doc_limit = pr_doc_waiver[0]
    if line_count > pr_doc_limit:
        limit_source = "declared exception" if pr_doc_waiver else "dynamic maximum"
        failures.append(
            f"{pr_doc} has {line_count} lines, {limit_source} is {pr_doc_limit} "
            f"({file_count} logical files, {change_lines} substantive changed lines, "
            f"{scenarios} scenarios)"
        )
    else:
        exception_note = (
            f" (PR-document-lines exception: {pr_doc_waiver[1]})" if pr_doc_waiver else ""
        )
        print(
            f"PASSED: {pr_doc} has {line_count}/{pr_doc_limit} lines "
            f"({file_count} logical files, {change_lines} substantive changed lines, "
            f"{scenarios} scenarios){exception_note}"
        )

    pr_doc_failures = validate_pr_doc(pr_doc)
    failures.extend(pr_doc_failures)
    if not pr_doc_failures:
        print("PASSED: PR-document name and section structure")

    failures.extend(report_open_fixmes())

    failures.extend(report_undefined_qualifiers(merge_base, untracked))
    failures.extend(report_final_var(merge_base, untracked))

    failures.extend(report_comment_ratio(merge_base, untracked))

    changed_pr_docs = pr_doc_candidates(paths)
    extra_pr_docs, extra_failures = parse_extra_pr_docs(pr_doc)
    failures.extend(extra_failures)
    further = max(0, len(changed_pr_docs) - 1)
    if extra_pr_docs and further == 0:
        failures.append(
            f"{pr_doc} declares a further-PR-documents exception, but no other PR document "
            "changed; remove it"
        )
    elif extra_pr_docs and extra_pr_docs[0] != further:
        failures.append(
            f"{pr_doc} declares {extra_pr_docs[0]} further PR documents, but {further} "
            "changed; correct the count"
        )
    elif extra_pr_docs:
        print(
            f"PASSED: {further} further PR documents changed "
            f"(further-PR-documents exception: {extra_pr_docs[1]})"
        )

    open_branches = open_origin_branches(base)
    failures.extend(report_conflicts(base, open_branches, paths))

    failures.extend(report_duplicate_rfc_numbers(merge_base, open_branches))

    failures.extend(check_release_note_date(pr_doc))

    failures.extend(check_verified_by_sections(pr_doc))

    waiver, waiver_failures = parse_scope_waiver(pr_doc)
    failures.extend(waiver_failures)
    if waiver and scope_score <= MAX_SCOPE_SCORE:
        failures.append(
            f"{pr_doc} declares a scope-budget exception, but the scope score "
            f"{scope_score} is within the default maximum {MAX_SCOPE_SCORE}; remove it"
        )
    scope_limit = waiver[0] if waiver else MAX_SCOPE_SCORE
    if scope_score > scope_limit:
        limit_source = "declared exception" if waiver else "maximum"
        failures.append(
            f"diff against {base} has scope score {scope_score}, {limit_source} is "
            f"{scope_limit} ({file_count} logical files + ceil({change_lines}/"
            f"{CHANGE_LINES_PER_SCOPE_POINT}) substantive change points)"
        )
    else:
        exception_note = f" (scope-budget exception: {waiver[1]})" if waiver else ""
        print(
            f"PASSED: diff against {base} has scope score "
            f"{scope_score}/{scope_limit}{exception_note}"
        )

    large_files = oversized_files(paths)
    for path, size in large_files:
        failures.append(
            f"{path} has {size} bytes, maximum is {MAX_FILE_SIZE} bytes"
        )
    if not large_files:
        print(f"PASSED: changed files are at most {MAX_FILE_SIZE} bytes")

    tracked_build_files = [
        path for path in git("ls-files", "-z", "--", "build").split("\0") if path
    ]
    if tracked_build_files:
        failures.append(
            "generated build files are tracked: " + ", ".join(tracked_build_files)
        )
    else:
        print("PASSED: no generated files under build/ are tracked")

    for failure in failures:
        print(f"FAILED: {failure}", file=sys.stderr)
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
