#!/usr/bin/env python3
"""Fill the `##### Verified by` sections of a PR document from the scenario test run.

The scenario tests write build/scenario-reports/index.json, which maps each report to the
scenarios it verifies, its test and its use-case.  This tool turns that into the links under
each `#### Scenario#<id>` heading, so that nobody has to copy test names or report URLs.

    tools/generate-verified-by <pr-doc>            rewrites the sections
    tools/generate-verified-by <pr-doc> --check    only reports differences

A section belongs to this tool from its `##### Verified by` heading up to the next heading, but
only while a test claims that scenario.  A scenario verified outside the scenario tests keeps its
hand-written section; only an empty one counts as unverified.  Put remarks which are not links
above the heading, or they get overwritten.

Which test claims which scenario is read from the @Scenario annotations in the sources, the index
only contributes report titles and use-cases.  An index which lacks a claiming test, e.g. after a
filtered test run, is incomplete: nothing gets rewritten, and --check says so instead of "stale".
A generated section carries a marker comment; if no test claims its scenario anymore, it fails as well.
Sections without that marker, e.g. hand-written ones of older PR documents, stay as written.
"""

import json
import os
import re
import subprocess
import sys
import urllib.parse
from pathlib import Path

INDEX = Path("build/scenario-reports/index.json")
PR_DOC_DIR = Path("doc/PR")
REPORTS_BASE = "https://vm4006.hostsharing.net/branches"
# the daily master@release job publishes the current reports, /branches/master is stale
MASTER_BRANCH_PATH = "master_release"
SCENARIO_HEADING = re.compile(r"^#### Scenario#([\d.]+):", re.MULTILINE)
VERIFIED_BY_HEADING = "##### Verified by"
TEST_SOURCES = Path("src/test/java")
TEST_METHOD = re.compile(r"\bvoid\s+(\w+)\s*\(")
# hand-written sections of older PR documents use the same link format, thus only this marks generated ones
GENERATED_MARKER = "<!-- generated by tools/generate-verified-by -->"


def source_path(class_name):
    """A nested test class lives in the file of its outer class."""
    return "../../src/test/java/" + class_name.split("$")[0].replace(".", "/") + ".java"


def simple_name(class_name):
    return class_name.split("$")[0].rsplit(".", 1)[-1]


def report_url(branch, report_title):
    return f"{REPORTS_BASE}/{branch}/reports/scenarios/" + urllib.parse.quote(report_title + ".html")


def current_branch():
    """The CI builds in a worktree with a detached HEAD, thus fall back to the origin ref
    which points at this commit; the report links name the branch, not the commit."""
    # Werkator names the branch it builds, even when origin has already moved on to a newer commit
    if os.environ.get("branch"):
        return os.environ["branch"].replace("/", "_")
    checked_out = subprocess.run(
        ["git", "branch", "--show-current"], capture_output=True, text=True
    ).stdout.strip()
    if not checked_out:
        pointing = subprocess.run(
            ["git", "for-each-ref", "--points-at", "HEAD", "--format=%(refname:short)",
             "refs/remotes/origin"],
            capture_output=True, text=True,
        ).stdout.split()
        candidates = [ref.removeprefix("origin/") for ref in pointing if not ref.endswith("/HEAD")]
        if not candidates:
            return None
        checked_out = sorted(candidates)[0]
    return checked_out.replace("/", "_")


def verified_by_block(entries, branch):
    lines = [VERIFIED_BY_HEADING, "", GENERATED_MARKER]
    for report_title, entry in entries:
        test = f"{simple_name(entry['testClass'])}.{entry['testMethod']}"
        lines.append(f"- [{test}]({source_path(entry['testClass'])})")
        if entry.get("useCase"):
            use_case = entry["useCase"]
            lines.append(f"  using the use-case [{simple_name(use_case)}]({source_path(use_case)})")
        lines.append(
            f"- Scenario-Reports “{report_title}”: [Branch]({report_url(branch, report_title)}),"
            f" [`master`]({report_url(MASTER_BRANCH_PATH, report_title)})"
        )
    return lines


def entries_of(index, scenario):
    found = [(title, entry) for title, entry in sorted(index.items()) if scenario in entry["scenarios"]]
    return found


def masked(java, strings=True):
    """Blanks out comments and, unless told otherwise, the content of strings and text blocks,
    keeping every offset, so that code and string values can be read at the same place."""
    out, i, n = [], 0, len(java)
    while i < n:
        is_string = True
        if java.startswith('"""', i):
            end = java.find('"""', i + 3)
            end = n if end < 0 else end + 3
        elif java[i] in "\"'":
            end = i + 1
            while end < n and java[end] != java[i] and java[end] != "\n":
                end += 2 if java[end] == "\\" else 1
            end = min(end + 1, n)
        elif java.startswith("//", i):
            is_string = False
            end = java.find("\n", i)
            end = n if end < 0 else end
        elif java.startswith("/*", i):
            is_string = False
            end = java.find("*/", i + 2)
            end = n if end < 0 else end + 2
        else:
            out.append(java[i])
            i += 1
            continue
        out.append(java[i:end] if is_string and not strings else re.sub(r"[^\n]", " ", java[i:end]))
        i = end
    return "".join(out)


def source_claims():
    """Maps each scenario to the tests which claim it, as (outer class, method), from the sources;
    an annotation may span several lines and applies to the next test method."""
    claims = {}
    for source in TEST_SOURCES.rglob("*.java"):
        outer_class = ".".join(source.relative_to(TEST_SOURCES).with_suffix("").parts)
        java = source.read_text(encoding="utf-8")
        code = masked(java)
        values = masked(java, strings=False)
        for annotation in re.finditer(r"@Scenario\s*\(", code):
            closing = code.find(")", annotation.end())
            method = TEST_METHOD.search(code, closing)
            if closing < 0 or not method:
                continue
            for scenario in re.findall(r'"([^"]+)"', values[annotation.end():closing]):
                claims.setdefault(scenario, set()).add((outer_class, method.group(1)))
    return claims


def index_claims(index, scenario):
    return {(entry["testClass"].split("$")[0], entry["testMethod"])
            for _, entry in entries_of(index, scenario)}


def rewrite(doc_lines, index, claims, branch):
    """Returns the new lines and the findings per kind; a section keeps its lines unless the index
    completely covers the tests which claim its scenario."""
    out, index_ = [], 0
    findings = {"unverified": [], "hand_written": [], "orphaned": [], "incomplete": []}
    scenario = None
    while index_ < len(doc_lines):
        line = doc_lines[index_]
        heading = SCENARIO_HEADING.match(line)
        if heading:
            scenario = heading.group(1)
        if line.strip() == VERIFIED_BY_HEADING:
            start = index_
            index_ += 1
            while index_ < len(doc_lines) and not doc_lines[index_].startswith("#"):
                index_ += 1
            existing = doc_lines[start:index_]
            claimed = claims.get(scenario, set())
            if claimed and claimed == index_claims(index, scenario):
                out.extend(verified_by_block(entries_of(index, scenario), branch))
                out.append("")
                continue
            if claimed:
                findings["incomplete"].append(scenario)
            elif any(li.strip() == GENERATED_MARKER for li in existing):
                findings["orphaned"].append(scenario)
            elif any(li.strip() for li in existing[1:]):
                findings["hand_written"].append(scenario)
            else:
                findings["unverified"].append(scenario)
            out.extend(existing)
            continue
        out.append(line)
        index_ += 1
    return out, findings


def scenarios_without_section(doc_text):
    declared = set(SCENARIO_HEADING.findall(doc_text))
    with_section = set()
    scenario = None
    for line in doc_text.split("\n"):
        heading = SCENARIO_HEADING.match(line)
        if heading:
            scenario = heading.group(1)
        elif line.strip() == VERIFIED_BY_HEADING and scenario:
            with_section.add(scenario)
    return sorted(declared - with_section)


def tests_without_scenario(claims):
    """A scenario is only claimed to be undeclared when its PR document is on this branch;
    a stacked or unrelated branch simply does not carry the other PRs' documents."""
    documented = set()
    known_prs = set()
    for doc in PR_DOC_DIR.glob("*.md"):
        pr = re.search(r"PR#(\d+)", doc.name)
        if pr:
            known_prs.add(pr.group(1))
        documented.update(SCENARIO_HEADING.findall(doc.read_text(encoding="utf-8")))
    return [f"{outer_class}.{method}: {scenario}"
            for scenario, tests in sorted(claims.items())
            if scenario.split(".")[0] in known_prs and scenario not in documented
            for outer_class, method in sorted(tests)]


def main():
    if any(a in ("-h", "-?", "--help") for a in sys.argv[1:]):
        print(__doc__.strip())
        return 0
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    check_only = "--check" in sys.argv[1:]
    if len(args) != 1:
        print(f"usage: {Path(sys.argv[0]).name} <pr-doc> [--check]", file=sys.stderr)
        return 2
    doc = Path(args[0])
    if not INDEX.is_file():
        print(f"SKIPPED: no {INDEX}, run the scenario tests to create it")
        return 0

    branch = current_branch()
    if branch is None:
        # e.g. during a rebase: a commit which no branch and no origin ref names
        print("SKIPPED: cannot determine the branch the report links should name")
        return 0

    index = json.loads(INDEX.read_text(encoding="utf-8"))
    text = doc.read_text(encoding="utf-8")
    failures = [f"{doc}: scenario {s} has no `{VERIFIED_BY_HEADING}` section"
                for s in scenarios_without_section(text)]
    claims = source_claims()
    new_lines, findings = rewrite(text.split("\n"), index, claims, branch)
    failures += [f"{doc}: scenario {s} is verified by nothing; annotate a scenario test with "
                 f"@Scenario(\"{s}\") or name what verifies it"
                 for s in findings["unverified"]]
    failures += [f"{doc}: scenario {s} still links generated reports, but no test claims it anymore"
                 for s in findings["orphaned"]]
    failures += [f"{doc}: scenario {s} is claimed by tests which {INDEX} does not match, "
                 "run the scenario tests to complete the index"
                 for s in findings["incomplete"]]
    for s in findings["hand_written"]:
        print(f"NOTE: scenario {s} has a section without generator marker and no @Scenario test, "
              "thus it stays as written")
    failures += [f"{orphan} is verified by a test, but no PR document declares it"
                 for orphan in tests_without_scenario(claims)]

    new_text = "\n".join(new_lines)
    # an incomplete index is no basis for rewriting a section or for calling it stale
    if findings["incomplete"]:
        new_text = text
    if check_only:
        if new_text != text:
            failures.append(f"{doc}: the `{VERIFIED_BY_HEADING}` sections are stale, "
                            f"run tools/generate-verified-by {doc}")
    elif new_text != text:
        doc.write_text(new_text, encoding="utf-8")
        print(f"{doc}: Verified-by sections rewritten")

    for failure in failures:
        print("FAILED: " + failure)
    if not failures:
        print(f"PASSED: the Verified-by sections of {doc} match the scenario tests")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
