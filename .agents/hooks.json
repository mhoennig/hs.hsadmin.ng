{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/tools/hooks/reject-final-var.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
